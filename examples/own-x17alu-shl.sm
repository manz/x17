; own-x17alu-shl mini program (silicon-measured byte-exact).
; Pre-loads s8 and s2, then runs the x17 ALU, then halts.
; Expected: s1 = (0x246 + 1) << 3 = 0x1238.

        ldi s8, #0x246          ; a = 0x246
        ldi s2, #0x001          ; b = 1
        x17.alu s1, s8, s2, #0, #3 ; op 0 = (a + b) << n
        x17.halt                ; stop
