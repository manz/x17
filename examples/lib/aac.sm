; One AAC-LC access unit (a raw_data_block): the x17 twin of `Decoder.decode` in sosumi's
; ref/dsp/aac/decoder.zig, its syntax from ref/aac/raw.zig and ref/aac/ics.zig. Needs
; lib/bits.sm, lib/mem.sm, lib/huffman.sm, lib/sections.sm, lib/dequant.sm, lib/stereo.sm,
; lib/pns.sm, lib/tns.sm, lib/imdct.sm and lib/window.sm first; bits_init must point the
; reader at the access unit (16-bit words, the first byte high).
;
; Elements: SCE and LFE (one channel), CPE (two), FIL and DSE skipped, until END. CCE and PCE
; stop with status 1. Per channel: parse into the record at CUR, pulses, dequantise, then for a
; pair: left PNS, M/S and intensity (common_window only), right PNS (mode 1 under
; common_window), and each channel's TNS, IMDCT (one long, or eight short with one exponent),
; window and overlap. The parse runs once and returns through AK_PH (0 SCE, 1 a pair's left,
; 2 its right); the channel tail runs once and returns through AK_FR.
;
; Y, filled by the host once:
;   AK_NCH channels (1 or 2), AK_NSWBL / AK_NSWBS bands per window size, AK_TOPL / AK_TOPS
;   TNS_MAX_BANDS, AK_BOOKS + b the code of book b (1..11; the scale factor code at HUFF0, root
;   width 8 for every code), SWB_L / SWB_S swb_offset (64 words each), the dequantiser's DQ_IE,
;   DQ_IR, the IMDCT's bit reversals at REVL (512) and REVS (64), Z + 2 rev(n) - 2 with Z = 0.
; Y state kept between access units: AK_SHP + slot each channel's previous window_shape.
; Y out: AK_ST status (0 ok, 1 CCE or PCE, 2 a syntax error, 3 an escape past 8 ones, 4 stereo
;   tools without common_window, 5 more channels than AK_NCH), OUTY the PCM, 1024 frames of
;   AK_NCH interleaved 16-bit samples.
; X, filled by the host once: the dequantiser's DQ_D, DQ_IT, DQ_G; PREL, POSTL, TWL and PRES,
;   POSTS, TWS, the IMDCT tables (long and short); WLONG + 0x400 s, WSHORT + 0x80 s the rising
;   window halves as w / 4 (s the shape); XSTT stereo T, XPNT and XSEED PNS T and seeds, XTNK
;   the TNS reflection table. Kept between access units: OVL0, OVL1 the overlaps, XRNG the
;   PNS generator (shared by the channels).
; Scratch: X 0x0000 .. 0x2FFF, WRISE, WFALL, XL, XSAVE; Y CUR, STL, STR, FIN, PCMY, the AK_
; slots and every stage's block. The reader's e5, s9, s10 are saved around the stages.

.const HUFF0    = 0x4800        ; scale factor code
.const AK       = 0x3C00
.const AK_NCH   = AK + 0
.const AK_ST    = AK + 1
.const AK_SLOT  = AK + 2
.const AK_PH    = AK + 3
.const AK_FR    = AK + 4
.const AK_CW    = AK + 5
.const AK_MSP   = AK + 6
.const AK_FSL   = AK + 7        ; the slot being finished
.const AK_RE5   = AK + 8
.const AK_RAV   = AK + 9
.const AK_NSWBL = AK + 10
.const AK_NSWBS = AK + 11
.const AK_TOPL  = AK + 12
.const AK_TOPS  = AK + 13
.const AK_SHP   = AK + 14       ; 2 words
.const AK_WGI   = AK + 16       ; walk: group index
.const AK_WFW   = AK + 17       ; the group's first window
.const AK_WWE   = AK + 18       ; past its last
.const AK_WI    = AK + 19       ; band pointer
.const AK_WOFF  = AK + 20       ; swb_offset table
.const AK_WSFB  = AK + 21
.const AK_WTAB  = AK + 22
.const AK_WBK   = AK + 23
.const AK_WO    = AK + 24       ; swb_offset[sfb]
.const AK_WNT   = AK + 25       ; tuples per window
.const AK_WW    = AK + 26
.const AK_WN    = AK + 27
.const AK_BOOKS = AK + 0x40     ; 12 words
.const SWB_L    = 0x3D00
.const SWB_S    = 0x3D40
.const PAIR_MSU = 0x3D80        ; 128 words
.const ESLOT    = 0x2390
.const REVL     = 0x2400
.const REVS     = 0x2D00
.const PCMY     = 0x3000
.const OUTY     = 0x3400

; a channel record
.const R_GG   = 0
.const R_WS   = 1
.const R_SH   = 2
.const R_MAX  = 3
.const R_GRP  = 4
.const R_NB   = 5
.const R_E    = 6
.const R_PUL  = 7
.const R_PCNT = 8
.const R_PST  = 9
.const R_TNS  = 10
.const R_GLEN = 0x10            ; 8 words
.const R_POFF = 0x18            ; 4 words
.const R_PAMP = 0x1C            ; 4 words
.const R_TREC = 0x20            ; 128 words
.const R_BOOK = 0x100           ; 129 words
.const R_SF   = 0x180           ; 128 words
.const R_SIZE = 0x200
.const R_HEAD = 0xA0            ; the part the channel tail reads
.const CUR    = 0x5C00
.const STL    = 0x6000
.const STR    = 0x6200
.const FIN    = 0x6400

.const PREL   = 0x1000
.const POSTL  = 0x1400
.const PRES   = 0x1A00
.const POSTS  = 0x1A80
.const TWS    = 0x1B00
.const IMT    = 0x2000          ; the IMDCT's output, the window's T
.const WB     = 0x2800          ; the window's block
.const TWL    = 0x3000
.const WRISE  = 0x3400
.const WFALL  = 0x3800
.const OVL0   = 0x3C00
.const OVL1   = 0x4000
.const XL     = 0x4400
.const WLONG  = 0x4800
.const WSHORT = 0x5000
.const XSTT   = 0x5100
.const XPNT   = 0x5104
.const XSEED  = 0x5108
.const XTNK   = 0x5110
.const XRNG   = 0x5130
.const XSAVE  = 0x5131

; Y[DST ..] = Y[SRC ..], N words. Uses s2, s3, s4, s13, e7, e8.
.macro ak_ycopy(DST, SRC, N) {
        ldi s13, #SRC - 1
        x17.mve e7, s13
        ldi s13, #DST - 1
        x17.mve e8, s13
        ldi s2, #N
cp:     ldy s3, e7
        x18.eagu e7, e7, #AGU_INC
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        alu s2, s2, s14, #OP_SUB
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, cp
        nop()
        nop()
}

; X[DST ..] = X[s5 ..], s6 words (s6 > 0). Uses s1, s2, s3, s4, A4, A8 and amov's registers.
.macro ak_xcopyd(DST) {
        amov(A4, s5)
        aimm(A8, DST)
        alu s3, s6, s0, #OP_ADD
xc:     x19.xrd s1, #4
        x02.ainc #4, #4
        stx A8, s1
        x02.ainc #8, #8
        alu s3, s3, s14, #OP_SUB
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, xc
        nop()
        nop()
}

.macro ak_xcopy(DST, SRC, N) {
        ldi s5, #SRC
        ldi s6, #N
        ak_xcopyd(DST)
}

; p3 = the record's window_sequence is eight_short. Uses s3, s4, s13, e6.
.macro ak_isshort(REC) {
        yld(s3, REC + R_WS)
        ldi s4, #2
        alu s4, s3, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
}

; Y[DST ..] = the record's swb_offset table, 64 words.
.macro ak_offs(DST, REC) {
        ak_isshort(REC)
        jmp #3, #3, short
        nop()
        nop()
        ak_ycopy(DST, SWB_L, 64)
        jmp #ALWAYS, #0, done
        nop()
        nop()
short:  ak_ycopy(DST, SWB_S, 64)
done:
}

; Y[DST] = 128 for a short record, else 1024.
.macro ak_win(DST, REC) {
        ak_isshort(REC)
        ldi s3, #1024
        jmp #IF_NOT, #3, put
        nop()
        nop()
        ldi s3, #128
put:    yst(DST)
}

; s4 = 1 when one of the record's R_NB books is V or W, else 0. Uses s1, s2, s3, s5, e7.
.macro ak_hasbook(REC, V, W) {
        ldi s13, #REC + R_BOOK - 1
        x17.mve e7, s13
        yld(s1, REC + R_NB)
        ldi s5, #0
hb:     alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        nop()
        nop()
        alu s1, s1, s14, #OP_SUB
        ldy s2, e7
        x18.eagu e7, e7, #AGU_INC
        ldi s3, #V
        alu s4, s2, s3, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, yes
        ldi s3, #W              ; (delay slot)
        alu s4, s2, s3, #OP_SUB ; (delay slot)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, hb
        nop()
        nop()
yes:    ldi s5, #1
done:   alu s4, s5, s0, #OP_ADD
}

; The bit reader out of the way of the stages, and back.
.macro ak_rsave() {
        x03.esrc s3, e5
        yst(AK_RE5)
        alu s3, s10, s0, #OP_ADD
        yst(AK_RAV)
        aimm(A12, XSAVE)
        stx A12, s9
}

.macro ak_rload() {
        yld(s13, AK_RE5)
        alu s13, s13, s14, #OP_SUB
        x17.mve e5, s13
        yld(s10, AK_RAV)
        aimm(A12, XSAVE)
        x19.xrd s9, #12
        ldi s14, #1
        ldi s15, #16
}

; ics_info() into CUR. A reserved bit, prediction, or max_sfb past the rate's bands jumps
; to FAIL. Uses s1 .. s5 and getbits's registers.
.macro ak_icsinfo(FAIL) {
        getbits(s3, 1)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, FAIL
        nop()
        nop()
        getbits(s3, 2)
        yst(CUR + R_WS)
        getbits(s3, 1)
        yst(CUR + R_SH)
        ldi s3, #1
        yst(CUR + R_GLEN)
        ak_isshort(CUR)
        jmp #3, #3, short
        nop()
        nop()
        getbits(s3, 6)
        yst(CUR + R_MAX)
        yld(s5, AK_NSWBL)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        jmp #IF_NOT, #3, FAIL
        nop()
        nop()
        ldi s3, #1
        yst(CUR + R_GRP)
        getbits(s3, 1)          ; predictor_data_present
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, FAIL
        nop()
        nop()
        jmp #ALWAYS, #0, done
        nop()
        nop()
short:  getbits(s3, 4)
        yst(CUR + R_MAX)
        yld(s5, AK_NSWBS)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        jmp #IF_NOT, #3, FAIL
        nop()
        nop()
        ; scale_factor_grouping: a set bit joins window i + 1 to the current group
        ldi s1, #1              ; groups
        ldi s2, #7
grp:    getbits(s5, 1)
        alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, newg
        nop()
        nop()
        ldi s13, #CUR + R_GLEN - 2
        alu s13, s13, s1, #OP_ADD
        x17.mve e6, s13         ; group_len[groups - 1]
        ldy s3, e6
        alu s3, s3, s14, #OP_ADD
        x17.sty e6, #3, #0
        jmp #ALWAYS, #0, gnext
        nop()
        nop()
newg:   ldi s13, #CUR + R_GLEN - 1
        alu s13, s13, s1, #OP_ADD
        x17.mve e6, s13
        ldi s3, #1
        x17.sty e6, #3, #0
        alu s1, s1, s14, #OP_ADD
gnext:  alu s2, s2, s14, #OP_SUB
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
        alu s3, s1, s0, #OP_ADD
        yst(CUR + R_GRP)
done:   yld(s1, CUR + R_GRP)    ; bands = groups * max_sfb
        yld(s2, CUR + R_MAX)
        ldi s3, #0
nb:     alu s3, s3, s2, #OP_ADD
        alu s1, s1, s14, #OP_SUB
        alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, nb
        nop()
        nop()
        yst(CUR + R_NB)
}

; tns_data() into CUR + R_TREC, in tns.sm's TN_REC order. NW windows; NFB, LB, OB the n_filt,
; length and order widths. Uses s1 .. s8, e8 and getbits's registers.
.macro ak_tnsparse(NW, NFB, LB, OB) {
        ldi s13, #CUR + R_TREC - 1
        x17.mve e8, s13
        ldi s1, #NW
win:    getbits(s3, NFB)        ; n_filt
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        alu s2, s3, s0, #OP_ADD
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wnext
        nop()
        nop()
        getbits(s5, 1)          ; coef_res
        alu s3, s5, s0, #OP_ADD
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
filt:   alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wnext
        nop()
        nop()
        alu s2, s2, s14, #OP_SUB
        getbits(s3, LB)         ; length
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        getbits(s3, OB)         ; order
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        alu s7, s3, s0, #OP_ADD
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, filt
        nop()
        nop()
        getbits(s3, 1)          ; direction
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        getbits(s8, 1)          ; coef_compress
        ldi s4, #3
        alu s4, s4, s5, #OP_ADD
        alu s8, s4, s8, #OP_SUB ; coefficient bits
coef:   alu s4, s7, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, filt
        nop()
        nop()
        alu s7, s7, s14, #OP_SUB
        alu s11, s8, s0, #OP_ADD
        getbits_s(s3)
        x19.alu s12, s14, s8, #SHIFT ; 2^bits
        alu s4, s3, s3, #OP_ADD
        alu s4, s4, s12, #OP_SUB ; 2v - 2^bits: the sign bit set when >= 0
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, pos
        nop()
        nop()
        alu s3, s3, s12, #OP_SUB
pos:    x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        jmp #ALWAYS, #0, coef
        nop()
        nop()
wnext:  alu s1, s1, s14, #OP_SUB
        alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, win
        nop()
        nop()
}

; One family's tuples for the current window: AK_WN codewords from the code at AK_WTAB.
.macro ak_tuples_qs(NEXT) {
more:   yld(s4, AK_WN)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, NEXT
        alu s3, s4, s14, #OP_SUB ; (delay slot)
        nop()
        yst(AK_WN)
        yld(s1, AK_WTAB)
        ldi s11, #8
        spec_quad_s()
        jmp #ALWAYS, #0, more
        nop()
        nop()
}

.macro ak_tuples_qu(NEXT) {
more:   yld(s4, AK_WN)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, NEXT
        alu s3, s4, s14, #OP_SUB ; (delay slot)
        nop()
        yst(AK_WN)
        yld(s1, AK_WTAB)
        ldi s11, #8
        spec_quad_u()
        jmp #ALWAYS, #0, more
        nop()
        nop()
}

.macro ak_tuples_ps(NEXT) {
more:   yld(s4, AK_WN)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, NEXT
        alu s3, s4, s14, #OP_SUB ; (delay slot)
        nop()
        yst(AK_WN)
        yld(s1, AK_WTAB)
        ldi s11, #8
        spec_pair_s()
        jmp #ALWAYS, #0, more
        nop()
        nop()
}

.macro ak_tuples_pu(NEXT) {
more:   yld(s4, AK_WN)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, NEXT
        alu s3, s4, s14, #OP_SUB ; (delay slot)
        nop()
        yst(AK_WN)
        yld(s1, AK_WTAB)
        ldi s11, #8
        spec_pair_u()
        jmp #ALWAYS, #0, more
        nop()
        nop()
}

.macro ak_tuples_esc(NEXT, FAIL) {
more:   yld(s4, AK_WN)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, NEXT
        alu s3, s4, s14, #OP_SUB ; (delay slot)
        nop()
        yst(AK_WN)
        yld(s1, AK_WTAB)
        ldi s11, #8
        spec_pair_esc(FAIL)
        jmp #ALWAYS, #0, more
        nop()
        nop()
}

; spectral_data() for CUR into X DQ_SPEC, window-major (w * 128 + k); zero, noise and
; intensity bands stay 0. An escape past 8 ones jumps to FAIL.
.macro ak_walk(FAIL) {
        aimm(A8, DQ_SPEC)
        ldi s3, #1024
wz:     stx A8, s0
        x02.ainc #8, #8
        alu s3, s3, s14, #OP_SUB
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, wz
        nop()
        nop()
        ldi s3, #0
        yst(AK_WGI)
        yst(AK_WFW)
        ldi s3, #AAC_BOOK
        yst(AK_WI)
        ak_isshort(CUR)
        ldi s3, #SWB_L
        jmp #IF_NOT, #3, offl
        nop()
        nop()
        ldi s3, #SWB_S
offl:   yst(AK_WOFF)
grp:    yld(s3, AK_WGI)
        yld(s5, CUR + R_GRP)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        ldi s13, #CUR + R_GLEN - 1 ; (delay slot)
        alu s13, s13, s3, #OP_ADD ; (delay slot)
        x17.mve e6, s13
        ldy s5, e6              ; group_len[g]
        yld(s3, AK_WFW)
        alu s3, s3, s5, #OP_ADD
        yst(AK_WWE)
        ldi s3, #0
        yst(AK_WSFB)
band:   yld(s3, AK_WSFB)
        yld(s5, CUR + R_MAX)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gnext
        nop()
        nop()
        yld(s13, AK_WI)
        alu s13, s13, s14, #OP_SUB
        x17.mve e6, s13
        ldy s2, e6              ; the band's book
        yld(s3, AK_WI)
        alu s3, s3, s14, #OP_ADD
        yst(AK_WI)
        alu s4, s2, s14, #OP_SUB
        ptst p3, s0, #LT4, #PTST ; ZERO_HCB
        jmp #3, #3, bnext
        ldi s4, #11             ; (delay slot)
        alu s4, s4, s2, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST ; noise or intensity
        jmp #3, #3, bnext
        nop()
        nop()
        ldi s13, #AK_BOOKS - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e6, s13
        ldy s3, e6
        yst(AK_WTAB)
        alu s3, s2, s0, #OP_ADD
        yst(AK_WBK)
        yld(s3, AK_WOFF)
        yld(s5, AK_WSFB)
        alu s13, s3, s5, #OP_ADD
        alu s13, s13, s14, #OP_SUB
        x17.mve e6, s13
        ldy s6, e6              ; swb_offset[sfb]
        x18.eagu e6, e6, #AGU_INC
        ldy s7, e6              ; swb_offset[sfb + 1]
        alu s3, s6, s0, #OP_ADD
        yst(AK_WO)
        alu s3, s7, s6, #OP_SUB ; the band's width
        ldi s5, #-1             ; pairs
        ldi s4, #5
        alu s4, s2, s4, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, pairs
        nop()
        nop()
        ldi s5, #-2             ; quads
pairs:  x19.alu s3, s3, s5, #SHIFT ; tuples (the width is a multiple of 4)
        yst(AK_WNT)
        yld(s3, AK_WFW)
        yst(AK_WW)
win:    yld(s3, AK_WW)
        yld(s5, AK_WWE)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, bnext
        ldi s4, #7              ; (delay slot)
        x19.alu s3, s3, s4, #SHIFT ; (delay slot) w * 128
        yld(s5, AK_WO)
        alu s3, s3, s5, #OP_ADD
        amov(A6, s3)
        yld(s3, AK_WNT)
        yst(AK_WN)
        yld(s2, AK_WBK)
        ldi s4, #3
        alu s4, s2, s4, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, fqs
        ldi s4, #5              ; (delay slot)
        alu s4, s2, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, fqu
        ldi s4, #7              ; (delay slot)
        alu s4, s2, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, fps
        ldi s4, #11             ; (delay slot)
        alu s4, s2, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, fpu
        nop()
        nop()
        ak_tuples_esc(wnext, FAIL)
fqs:    ak_tuples_qs(wnext)
fqu:    ak_tuples_qu(wnext)
fps:    ak_tuples_ps(wnext)
fpu:    ak_tuples_pu(wnext)
wnext:  yld(s3, AK_WW)
        alu s3, s3, s14, #OP_ADD
        yst(AK_WW)
        jmp #ALWAYS, #0, win
        nop()
        nop()
bnext:  yld(s3, AK_WSFB)
        alu s3, s3, s14, #OP_ADD
        yst(AK_WSFB)
        jmp #ALWAYS, #0, band
        nop()
        nop()
gnext:  yld(s3, AK_WWE)
        yst(AK_WFW)
        yld(s3, AK_WGI)
        alu s3, s3, s14, #OP_ADD
        yst(AK_WGI)
        jmp #ALWAYS, #0, grp
        nop()
        nop()
done:
}

; pulse_data's amplitudes onto CUR's spectrum (long windows only, sosumi dequant.applyPulse):
; a positive coefficient grows by amp, any other shrinks by it.
.macro ak_pulse() {
        yld(s4, CUR + R_PUL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        nop()
        nop()
        yld(s3, CUR + R_PST)
        ldi s13, #SWB_L - 1
        alu s13, s13, s3, #OP_ADD
        x17.mve e6, s13
        ldy s1, e6              ; k
        ldi s2, #0
pl:     yld(s5, CUR + R_PCNT)
        alu s4, s2, s5, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        ldi s13, #CUR + R_POFF - 1 ; (delay slot)
        alu s13, s13, s2, #OP_ADD ; (delay slot)
        x17.mve e6, s13
        ldy s5, e6
        alu s1, s1, s5, #OP_ADD ; k += offset
        ldi s13, #CUR + R_PAMP - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e6, s13
        ldy s6, e6              ; amp
        amov(A8, s1)
        x19.xrd s3, #8
        alu s4, s0, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST ; positive
        alu s5, s3, s6, #OP_ADD
        jmp #3, #3, put
        nop()
        nop()
        alu s5, s3, s6, #OP_SUB
put:    stx A8, s5
        alu s2, s2, s14, #OP_ADD
        jmp #ALWAYS, #0, pl
        nop()
        nop()
done:
}

; individual_channel_stream() into CUR and X DQ_SPEC, then its pulses and the dequantiser:
; words at X DQ_OUT, the exponent at CUR + R_E. COMMON: AK_CW and AK_PH != 0 (a CPE's shared
; ics_info is already in CUR).
.macro ak_ics(SYN, ESC) {
        getbits(s3, 8)
        yst(CUR + R_GG)
        yld(s4, AK_PH)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, info
        nop()
        nop()
        yld(s4, AK_CW)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, sect
        nop()
        nop()
info:   ak_icsinfo(SYN)
sect:   yld(s1, CUR + R_GRP)
        yld(s2, CUR + R_MAX)
        ak_isshort(CUR)
        jmp #3, #3, sshort
        nop()
        nop()
        aac_sections(5, 31, SYN)
        jmp #ALWAYS, #0, sfac
        nop()
        nop()
sshort: aac_sections(3, 7, SYN)
sfac:   yld(s1, CUR + R_GG)
        aac_scalefactors(HUFF0, SYN)
        getbits(s3, 1)          ; pulse_data_present
        yst(CUR + R_PUL)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, tns
        nop()
        nop()
        ak_isshort(CUR)
        jmp #3, #3, SYN
        nop()
        nop()
        getbits(s3, 2)
        alu s3, s3, s14, #OP_ADD
        yst(CUR + R_PCNT)
        alu s1, s3, s0, #OP_ADD
        getbits(s3, 6)
        yst(CUR + R_PST)
        ldi s13, #CUR + R_POFF - 1
        x17.mve e8, s13
        ldi s13, #CUR + R_PAMP - 1
        x17.mve e7, s13
pulse:  getbits(s3, 5)
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        getbits(s3, 4)
        x17.sty e7, #3, #0
        x18.eagu e7, e7, #AGU_INC
        alu s1, s1, s14, #OP_SUB
        alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, pulse
        nop()
        nop()
tns:    getbits(s3, 1)          ; tns_data_present
        yst(CUR + R_TNS)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gain
        nop()
        nop()
        ak_isshort(CUR)
        jmp #3, #3, tshort
        nop()
        nop()
        ak_tnsparse(1, 2, 6, 5)
        jmp #ALWAYS, #0, gain
        nop()
        nop()
tshort: ak_tnsparse(8, 1, 4, 3)
gain:   getbits(s3, 1)          ; gain_control_data_present
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, SYN
        nop()
        nop()
        ak_walk(ESC)
        ak_ycopy(CUR + R_BOOK, AAC_BOOK, 129)
        ak_ycopy(CUR + R_SF, AAC_SF, 128)
        ak_rsave()
        ak_pulse()
        yld(s3, CUR + R_GRP)
        yst(DQ_GRP)
        yld(s3, CUR + R_MAX)
        yst(DQ_MAX)
        ak_win(DQ_WIN, CUR)
        ak_ycopy(DQ_GLEN, CUR + R_GLEN, 8)
        ak_offs(DQ_OFF, CUR)
        dq_channel()
        yld(s3, DQ_E)
        yst(CUR + R_E)
}

; PNS for REC (mode 0), or for STR as a pair's right with STL its left (mode 1). Skipped when
; REC has no noise band. The generator lives at XRNG between calls.
.macro ak_pns(REC, MODE) {
        ak_hasbook(REC, 13, 13)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        nop()
        nop()
        yld(s3, REC + R_NB)
        yst(PN_NB)
        yld(s3, REC + R_GRP)
        yst(PN_GRP)
        yld(s3, REC + R_MAX)
        yst(PN_MAX)
        ak_win(PN_WIN, REC)
        ldi s3, #MODE
        yst(PN_MODE)
        ldi s3, #0
        yst(PN_MSP)
        yld(s3, REC + R_E)
        yst(PN_E)
        yld(s3, STL + R_E)
        yst(PN_EL)
        ak_ycopy(PN_GLEN, REC + R_GLEN, 8)
        ak_offs(PN_OFF, REC)
        ak_ycopy(PN_BOOK, REC + R_BOOK, 128)
        ak_ycopy(PN_SF, REC + R_SF, 128)
        ldi s4, #MODE
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, tabs
        nop()
        nop()
        yld(s3, AK_MSP)
        yst(PN_MSP)
        ak_ycopy(PN_LBOOK, STL + R_BOOK, 128)
        ak_ycopy(PN_LSF, STL + R_SF, 128)
        ak_ycopy(PN_MSU, PAIR_MSU, 128)
tabs:   ak_xcopy(PN_T, XPNT, 4)
        ak_xcopy(PN_SEED, XSEED, 6)
        ak_xcopy(PN_RNG, XRNG, 1)
        pns_channel()
        ak_xcopy(XRNG, PN_RNG, 1)
        yld(s3, PN_E)
        yst(REC + R_E)
done:
}

; M/S and intensity on STL (X ST_L) and STR (X ST_R), common_window only. Skipped when there
; is no M/S mask and no intensity band.
.macro ak_stereo() {
        yld(s4, AK_MSP)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, go
        nop()
        nop()
        ak_hasbook(STR, 14, 15)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        nop()
        nop()
go:     yld(s3, STL + R_NB)
        yst(ST_NB)
        yld(s3, STL + R_GRP)
        yst(ST_GRP)
        yld(s3, STL + R_MAX)
        yst(ST_MAX)
        ak_win(ST_WIN, STL)
        yld(s3, AK_MSP)
        yst(ST_MSP)
        yld(s3, STL + R_E)
        yst(ST_EL)
        yld(s3, STR + R_E)
        yst(ST_ER)
        ak_ycopy(ST_GLEN, STL + R_GLEN, 8)
        ak_offs(ST_OFF, STL)
        ak_ycopy(ST_LB, STL + R_BOOK, 128)
        ak_ycopy(ST_RB, STR + R_BOOK, 128)
        ak_ycopy(ST_RS, STR + R_SF, 128)
        ak_ycopy(ST_MSU, PAIR_MSU, 128)
        ak_xcopy(ST_T, XSTT, 4)
        stereo_pair()
        yld(s3, ST_EL)
        yst(STL + R_E)
        yld(s3, ST_ER)
        yst(STR + R_E)
done:
}

; TNS on FIN's words at X TN_W.
.macro ak_tns() {
        yld(s4, FIN + R_TNS)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        nop()
        nop()
        ak_xcopy(TN_K, XTNK, 24)
        yld(s3, FIN + R_E)
        yst(TN_E)
        ak_offs(TN_OFF, FIN)
        ak_ycopy(TN_REC, FIN + R_TREC, 128)
        ak_win(TN_WLEN, FIN)
        yld(s1, AK_NSWBL)
        yld(s2, AK_TOPL)
        ldi s5, #1
        ldi s6, #12
        ak_isshort(FIN)
        jmp #IF_NOT, #3, put
        nop()
        nop()
        yld(s1, AK_NSWBS)
        yld(s2, AK_TOPS)
        ldi s5, #8
        ldi s6, #7
put:    yld(s7, FIN + R_MAX)    ; top = min(TNS_MAX_BANDS, max_sfb)
        alu s4, s7, s2, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, top
        nop()
        nop()
        alu s2, s7, s0, #OP_ADD
top:    alu s3, s5, s0, #OP_ADD
        yst(TN_NWIN)
        alu s3, s1, s0, #OP_ADD
        yst(TN_NSWB)
        alu s3, s2, s0, #OP_ADD
        yst(TN_TOP)
        alu s3, s6, s0, #OP_ADD
        yst(TN_MAXO)
        tns_channel()
        yld(s3, TN_E)
        yst(FIN + R_E)
done:
}

; The window halves for FIN: the rising side from the previous shape (long for only_long and
; long_start, else short), the falling side from the current one (long for only_long and
; long_stop, else short).
.macro ak_halves() {
        yld(s3, AK_FSL)
        ldi s13, #AK_SHP - 1
        alu s13, s13, s3, #OP_ADD
        x17.mve e6, s13
        ldy s8, e6              ; prev_shape
        yld(s2, FIN + R_WS)
        ldi s4, #2
        alu s4, s2, s4, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, rshort
        ldi s4, #10             ; (delay slot)
        x19.alu s5, s8, s4, #SHIFT ; (delay slot) prev * 0x400
        ldi s4, #WLONG
        alu s5, s5, s4, #OP_ADD
        ldi s6, #1024
        jmp #ALWAYS, #0, rcopy
        nop()
        nop()
rshort: ldi s4, #7
        x19.alu s5, s8, s4, #SHIFT
        ldi s4, #WSHORT
        alu s5, s5, s4, #OP_ADD
        ldi s6, #128
rcopy:  ak_xcopyd(WRISE)
        yld(s8, FIN + R_SH)
        yld(s2, FIN + R_WS)
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST ; only_long
        jmp #3, #3, flong
        ldi s4, #3              ; (delay slot)
        alu s4, s2, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #EQ4, #PTST ; long_stop
        jmp #3, #3, flong
        nop()
        nop()
        ldi s4, #7
        x19.alu s5, s8, s4, #SHIFT
        ldi s4, #WSHORT
        alu s5, s5, s4, #OP_ADD
        ldi s6, #128
        jmp #ALWAYS, #0, fcopy
        nop()
        nop()
flong:  ldi s4, #10
        x19.alu s5, s8, s4, #SHIFT
        ldi s4, #WLONG
        alu s5, s5, s4, #OP_ADD
        ldi s6, #1024
fcopy:  ak_xcopyd(WFALL)
}

; The window for one channel's overlap OVL, by FIN's window_sequence, into Y PCMY.
.macro ak_window(OVL) {
        yld(s2, FIN + R_WS)
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wl
        ldi s4, #2              ; (delay slot)
        alu s4, s2, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, wst
        nop()
        nop()
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wsh
        nop()
        nop()
        win_stop(IMT, WRISE, WFALL, WB, OVL, PCMY)
        jmp #ALWAYS, #0, done
        nop()
        nop()
wl:     win_long(IMT, WRISE, WFALL, OVL, PCMY)
        jmp #ALWAYS, #0, done
        nop()
        nop()
wst:    win_start(IMT, WRISE, WFALL, WB, OVL, PCMY)
        jmp #ALWAYS, #0, done
        nop()
        nop()
wsh:    win_short(IMT, WRISE, WFALL, WB, OVL, PCMY)
done:
}

; FIN's channel from its words at X 0x0400 to PCM in slot AK_FSL of OUTY.
.macro ak_finish() {
        ak_tns()
        yld(s3, FIN + R_E)
        yst(ESLOT)
        ak_isshort(FIN)
        jmp #3, #3, ishort
        nop()
        nop()
        imdct(1024, 512, 10, 9, DQ_OUT, DQ_SPEC, IMT, PREL, POSTL, TWL, REVL, ESLOT)
        jmp #ALWAYS, #0, halves
        nop()
        nop()
ishort: imdct(128, 64, 7, 6, DQ_OUT, DQ_SPEC, IMT, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 128, DQ_SPEC, IMT + 256, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 256, DQ_SPEC, IMT + 512, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 384, DQ_SPEC, IMT + 768, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 512, DQ_SPEC, IMT + 1024, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 640, DQ_SPEC, IMT + 1280, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 768, DQ_SPEC, IMT + 1536, PRES, POSTS, TWS, REVS, ESLOT)
        imdct(128, 64, 7, 6, DQ_OUT + 896, DQ_SPEC, IMT + 1792, PRES, POSTS, TWS, REVS, ESLOT)
halves: ak_halves()
        yld(s4, AK_FSL)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, slot1
        nop()
        nop()
        ak_window(OVL0)
        jmp #ALWAYS, #0, shape
        nop()
        nop()
slot1:  ak_window(OVL1)
shape:  yld(s3, AK_FSL)
        ldi s13, #AK_SHP - 1
        alu s13, s13, s3, #OP_ADD
        x17.mve e8, s13
        yld(s3, FIN + R_SH)
        x17.sty e8, #3, #0      ; prev_shape = window_shape
        ; PCM into slot AK_FSL of the interleaved output
        yld(s3, AK_FSL)
        ldi s6, #OUTY - 1
        alu s6, s6, s3, #OP_ADD
        yld(s5, AK_NCH)
        ldi s13, #PCMY - 1
        x17.mve e7, s13
        ldi s2, #1024
il:     ldy s3, e7
        x18.eagu e7, e7, #AGU_INC
        x17.mve e8, s6
        x17.sty e8, #3, #0
        alu s6, s6, s5, #OP_ADD
        alu s2, s2, s14, #OP_SUB
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, il
        nop()
        nop()
}

.macro aac_packet() {
        ldi s3, #0
        yst(AK_ST)
        yst(AK_SLOT)

ak_elem:
        getbits(s3, 3)          ; id_syn_ele
        ldi s4, #7
        alu s4, s3, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_end      ; END
        ldi s4, #6              ; (delay slot)
        alu s4, s3, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_fil
        nop()
        nop()
        getbits(s5, 4)          ; element_instance_tag
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_sce
        ldi s4, #3              ; (delay slot)
        alu s4, s3, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_sce      ; LFE
        alu s4, s3, s14, #OP_SUB ; (delay slot)
        nop()
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_cpe
        ldi s4, #4              ; (delay slot)
        alu s4, s3, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_dse
        nop()
        nop()
        ldi s3, #1              ; CCE, PCE
        jmp #ALWAYS, #0, ak_fail
        nop()
        nop()

ak_fil: getbits(s1, 4)          ; count
        ldi s4, #15
        alu s4, s1, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, ak_skip
        nop()
        nop()
        getbits(s3, 8)
        alu s1, s1, s3, #OP_ADD
        alu s1, s1, s14, #OP_SUB
ak_skip:
        alu s4, s1, s0, #OP_ADD ; skip s1 bytes
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_elem
        nop()
        nop()
        getbits(s3, 8)
        alu s1, s1, s14, #OP_SUB
        jmp #ALWAYS, #0, ak_skip
        nop()
        nop()

ak_dse: getbits(s2, 1)          ; data_byte_align_flag
        getbits(s1, 8)
        ldi s4, #255
        alu s4, s1, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, ak_dsea
        nop()
        nop()
        getbits(s3, 8)
        alu s1, s1, s3, #OP_ADD
ak_dsea:
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_skip
        nop()
        nop()
        field(s5, s11, s10, 3, 4) ; the unit starts word-aligned: avail mod 8 bits to the byte
        getbits_s(s3)
        jmp #ALWAYS, #0, ak_skip
        nop()
        nop()

ak_sce: yld(s3, AK_SLOT)
        yld(s5, AK_NCH)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, ak_many
        nop()
        nop()
        ldi s3, #0
        yst(AK_PH)
        yst(AK_CW)
        jmp #ALWAYS, #0, ak_parse
        nop()
        nop()

ak_cpe: yld(s3, AK_SLOT)
        alu s3, s3, s14, #OP_ADD
        yld(s5, AK_NCH)
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, ak_many
        nop()
        nop()
        ldi s3, #1
        yst(AK_PH)
        getbits(s3, 1)          ; common_window
        yst(AK_CW)
        ldi s3, #0
        yst(AK_MSP)
        yld(s4, AK_CW)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_parse
        nop()
        nop()
        ak_icsinfo(ak_syn)
        getbits(s3, 2)          ; ms_mask_present
        yst(AK_MSP)
        ldi s4, #3
        alu s4, s3, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_syn
        nop()
        nop()
        ldi s13, #PAIR_MSU - 1
        x17.mve e8, s13
        yld(s1, CUR + R_NB)
        yld(s2, AK_MSP)
        ldi s4, #-1
        x19.alu s7, s2, s4, #SHIFT ; 0 or 1: the value for none or all
ak_msu: alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_parse
        alu s1, s1, s14, #OP_SUB ; (delay slot)
        alu s4, s2, s14, #OP_SUB ; (delay slot)
        ptst p3, s0, #EQ4, #PTST ; 1: one bit per band
        jmp #IF_NOT, #3, ak_msput
        alu s3, s7, s0, #OP_ADD ; (delay slot)
        nop()
        getbits(s3, 1)
ak_msput:
        x17.sty e8, #3, #0
        x18.eagu e8, e8, #AGU_INC
        jmp #ALWAYS, #0, ak_msu
        nop()
        nop()

ak_parse:
        ak_ics(ak_syn, ak_esc)
        yld(s4, AK_PH)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_one
        alu s4, s4, s14, #OP_SUB ; (delay slot)
        nop()
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_left
        nop()
        nop()

        ; a pair's right: both channels' tools, then the right's tail, then the left's
        ak_ycopy(STR, CUR, R_SIZE)
        ak_xcopy(ST_R, DQ_OUT, 1024)
        ak_xcopy(ST_L, XL, 1024)
        ak_pns(STL, 0)
        yld(s4, AK_CW)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, ak_st
        nop()
        nop()
        ak_hasbook(STR, 14, 15)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_nost
        nop()
        nop()
        ldi s3, #4
        jmp #ALWAYS, #0, ak_fail
        nop()
        nop()
ak_st:  ak_stereo()
ak_nost:
        ak_xcopy(XL, ST_L, 1024) ; right to PN_W, left to PN_L
        ak_xcopy(PN_W, ST_R, 1024)
        ak_xcopy(PN_L, XL, 1024)
        yld(s4, AK_CW)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_pnr0
        nop()
        nop()
        ak_pns(STR, 1)
        jmp #ALWAYS, #0, ak_pnr
        nop()
        nop()
ak_pnr0:
        ak_pns(STR, 0)
ak_pnr: ak_ycopy(FIN, STR, R_HEAD)
        yld(s3, AK_SLOT)
        alu s3, s3, s14, #OP_ADD
        yst(AK_FSL)
        ldi s3, #1
        yst(AK_FR)
        jmp #ALWAYS, #0, ak_fin
        nop()
        nop()

ak_left:                        ; a pair's left: keep its words, parse the right
        ak_ycopy(STL, CUR, R_SIZE)
        ak_xcopy(XL, DQ_OUT, 1024)
        ak_rload()
        ldi s3, #2
        yst(AK_PH)
        jmp #ALWAYS, #0, ak_parse
        nop()
        nop()

        ; far targets, halfway: every jump stays within reach
ak_elemt:
        jmp #ALWAYS, #0, ak_elem
        nop()
        nop()
ak_many:
        ldi s3, #5
        jmp #ALWAYS, #0, ak_fail
        nop()
        nop()
ak_esc: ldi s3, #3
        jmp #ALWAYS, #0, ak_fail
        nop()
        nop()
ak_syn: ldi s3, #2
ak_fail:
        yst(AK_ST)
ak_end: jmp #ALWAYS, #0, ak_out
        nop()
        nop()

ak_one: ak_ycopy(STL, CUR, R_SIZE)
        ak_pns(STL, 0)
        ak_ycopy(FIN, STL, R_HEAD)
        yld(s3, AK_SLOT)
        yst(AK_FSL)
        ldi s3, #0
        yst(AK_FR)

ak_fin: ak_finish()
        yld(s4, AK_FR)
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, ak_done
        nop()
        nop()
        ak_xcopy(DQ_OUT, PN_L, 1024) ; the left's tail
        ak_ycopy(FIN, STL, R_HEAD)
        yld(s3, AK_SLOT)
        yst(AK_FSL)
        ldi s3, #2
        yst(AK_FR)
        jmp #ALWAYS, #0, ak_fin
        nop()
        nop()
ak_done:
        yld(s3, AK_SLOT)        ; one slot for an SCE, two for a pair
        alu s3, s3, s14, #OP_ADD
        yld(s4, AK_FR)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ak_next
        nop()
        nop()
        alu s3, s3, s14, #OP_ADD
ak_next:
        yst(AK_SLOT)
        ak_rload()
        jmp #ALWAYS, #0, ak_elemt
        nop()
        nop()
ak_out:
}
