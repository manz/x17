; AAC section_data() and scale_factor_data(): the x17 twin of sosumi's ref/dsp/aac/sections.zig.
;
; Bands are flat, group by group (band g * max_sfb + sfb), one Y word each: the book list at
; AAC_BOOK, ended by -1, and the scale factors at AAC_SF. Every test is a sign or zero test of
; s4 or s8. Needs lib/bits.sm and lib/huffman.sm.

.const AAC_BOOK = 0x2000        ; 120 bands at most, then -1
.const AAC_SF   = 0x2080
.const AAC_ACC  = 0x2100        ; +0 scale factor, +1 noise energy, +2 intensity, +3 PCM pending

; aac_sections(sb, esc, fail): s1 = window groups (1..8), s2 = max_sfb; sb = sect_bits (5 long,
; 3 short), esc = 2^sb - 1. Book 12 or a section running past max_sfb jumps to fail. Uses e7,
; s1..s8 and getbits's registers.
.macro aac_sections(sb, esc, fail) {
        ldi s13, #AAC_BOOK - 1
        x17.mve e7, s13
grp:    alu s3, s2, s0, #OP_ADD ; bands left in the group
sect:   alu s4, s3, s0, #OP_ADD
        ptst p1, s0, #EQ4, #PTST
        jmp #3, #1, gdone
        nop()
        nop()
        getbits(s5, 4)          ; sect_cb
        ldi s4, #12
        alu s4, s5, s4, #OP_SUB
        ptst p1, s0, #EQ4, #PTST ; reserved
        jmp #3, #1, fail
        nop()
        ldi s7, #0              ; (second delay slot) length
incr:   getbits(s8, sb)
        alu s7, s7, s8, #OP_ADD
        ldi s4, #esc
        alu s8, s8, s4, #OP_SUB
        ptst p1, s0, #EQ8, #PTST ; an escape: more length follows
        jmp #3, #1, incr
        nop()
        nop()
        alu s3, s3, s7, #OP_SUB
        alu s4, s3, s0, #OP_ADD
        ptst p1, s0, #LT4, #PTST ; past max_sfb
        jmp #3, #1, fail
        nop()
        nop()
fill:   alu s4, s7, s0, #OP_ADD
        ptst p1, s0, #EQ4, #PTST
        jmp #3, #1, sect
        nop()
        nop()
        x17.sty e7, #5, #0
        x18.eagu e7, e7, #AGU_INC
        alu s7, s7, s14, #OP_SUB
        jmp #IF_NOT, #2, fill
        nop()
        nop()
gdone:  alu s1, s1, s14, #OP_SUB
        alu s4, s1, s0, #OP_ADD
        ptst p1, s0, #EQ4, #PTST
        jmp #IF_NOT, #1, grp
        nop()
        nop()
        alu s5, s0, s14, #OP_SUB
        x17.sty e7, #5, #0      ; -1 ends the list
}

; aac_scalefactors(tab, fail): s1 = global_gain; tab = the scale factor code's Y address (root
; 8). Scale factors run from global_gain, noise energy from global_gain - 90 (its first value a
; 9-bit PCM word less 256), intensity positions from 0. A scale factor outside 0..255 jumps to
; fail. Uses e6, e7, e8 and huff_decode's registers; the running values live at AAC_ACC.
.macro aac_scalefactors(tab, fail) {
        ldi s13, #AAC_ACC - 1
        x17.mve e8, s13
        x17.sty e8, #1, #0      ; scale factor = global_gain
        x18.eagu e8, e8, #AGU_INC
        ldi s4, #90
        alu s2, s1, s4, #OP_SUB
        x17.sty e8, #2, #0      ; noise = global_gain - 90
        x18.eagu e8, e8, #AGU_INC
        alu s2, s0, s0, #OP_ADD
        x17.sty e8, #2, #0      ; intensity = 0
        x18.eagu e8, e8, #AGU_INC
        alu s2, s14, s0, #OP_ADD
        x17.sty e8, #2, #0      ; PCM pending
        ldi s13, #AAC_BOOK - 1
        x17.mve e7, s13
        ldi s13, #AAC_SF - 1
        x17.mve e8, s13
band:   ldy s2, e7
        alu s4, s2, s0, #OP_ADD
        ptst p1, s0, #LT4, #PTST ; -1: the end
        jmp #3, #1, done
        nop()
        nop()
        ptst p1, s0, #EQ4, #PTST ; ZERO_HCB: 0, no codeword
        jmp #3, #1, put
        alu s5, s0, s0, #OP_ADD ; (delay slot)
        nop()
        ldi s4, #13
        alu s4, s2, s4, #OP_SUB
        ptst p1, s0, #EQ4, #PTST
        jmp #IF_NOT, #1, dec    ; not NOISE_HCB
        ldi s13, #AAC_ACC + 3 - 1 ; (delay slot)
        x17.mve e6, s13         ; (delay slot) e6 = PCM pending
        ldy s4, e6
        ptst p1, s0, #EQ4, #PTST
        jmp #3, #1, dec         ; the PCM value is behind us
        nop()
        nop()
        alu s5, s0, s0, #OP_ADD
        x17.sty e6, #5, #0
        ldi s7, #9
        readn(s3)
        ldi s4, #256
        alu s3, s3, s4, #OP_SUB
        jmp #IF_NOT, #2, acc
        nop()
        nop()
dec:    ldi s1, #tab
        ldi s11, #8
        huff_decode(s3)
        ldi s4, #60
        alu s3, s3, s4, #OP_SUB ; the delta
acc:    ldy s2, e7              ; the book again: huff_decode took every register
        ldi s4, #13
        alu s4, s2, s4, #OP_SUB
        ptst p1, s0, #LT4, #PTST
        jmp #3, #1, sfac        ; a spectral book
        ldi s13, #AAC_ACC - 1   ; (delay slot)
        nop()
        ptst p1, s0, #EQ4, #PTST
        jmp #3, #1, add
        ldi s13, #AAC_ACC + 1 - 1 ; (delay slot) noise
        nop()
        ldi s13, #AAC_ACC + 2 - 1 ; intensity
add:    x17.mve e6, s13
        ldy s5, e6
        alu s5, s5, s3, #OP_ADD
        x17.sty e6, #5, #0
        jmp #IF_NOT, #2, put
        nop()
        nop()
sfac:   x17.mve e6, s13
        ldy s5, e6
        alu s5, s5, s3, #OP_ADD
        x17.sty e6, #5, #0
        alu s4, s5, s0, #OP_ADD
        ptst p1, s0, #LT4, #PTST ; below 0
        jmp #3, #1, fail
        ldi s4, #255            ; (delay slot)
        alu s4, s4, s5, #OP_SUB ; (delay slot)
        ptst p1, s0, #LT4, #PTST ; above 255
        jmp #3, #1, fail
        nop()
        nop()
put:    x17.sty e8, #5, #0
        x18.eagu e8, e8, #AGU_INC
        x18.eagu e7, e7, #AGU_INC
        jmp #IF_NOT, #2, band
        nop()
        nop()
done:
}
