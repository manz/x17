; AAC inverse quantisation: the x17 twin of sosumi's ref/dsp/aac/dequant.zig `dequantChannel`.
;
; A channel comes out as words with one exponent, value = w * 2^E, the IMDCT's block-floating
; form. Pass 1 finds E from each spectral band's largest |q|; pass 2 writes every coefficient,
; P = round(m * G / 2^23) shifted right (rounded) by E - (em + 2 + floor((sf - 100) / 4)), at
; most 23. |q|^(4/3) = m * 2^em comes from a direct table to 128, above it from the reference's
; Q13 interpolation with s found by comparisons (dq_mant).
;
; Needs lib/bits.sm (constants, nop, s14 = 1), lib/mem.sm and lib/sections.sm (the
; band lists at AAC_BOOK and AAC_SF). Tables, loaded by the host:
;   X DQ_D   k^(4/3) for k = 0..128 as pairs m, em (m in [2^22, 2^23))
;   X DQ_IT  round(j^(4/3) * 2^13), j = 64..128
;   X DQ_G   round(2^(rem / 3 + b / 4) * 2^21), indexed 4 rem + b
;   Y DQ_IE  floor(4s / 3) - 13 and Y DQ_IR 4 (s mod 3), s = 0..7
;   Y DQ_OFF swb_offset for the window size
; Shape slots in Y: DQ_GRP groups, DQ_MAX max_sfb, DQ_WIN window length (1024 or 128),
; DQ_GLEN group lengths. Spectrum q in X at DQ_SPEC (sign-extended words), words out at DQ_OUT,
; E out at Y DQ_E. Uses every s register but s14, s15; e6..e11; A2, A3, A8, A9 and mem.sm's.

.const DQ_D    = 0x1800
.const DQ_IT   = 0x1910
.const DQ_G    = 0x1960
.const DQ_SPEC = 0x0000
.const DQ_OUT  = 0x0400
.const DQ_IE   = 0x2140
.const DQ_IR   = 0x2148
.const DQ_OFF  = 0x2180
.const DQ_Y    = 0x2150
.const DQ_GRP  = DQ_Y + 0
.const DQ_MAX  = DQ_Y + 1
.const DQ_WIN  = DQ_Y + 2
.const DQ_GLEN = DQ_Y + 3       ; 8 words
.const DQ_E    = DQ_Y + 11
.const DQ_GL   = DQ_Y + 12      ; groups left
.const DQ_SL   = DQ_Y + 13      ; bands left in the group
.const DQ_WB   = DQ_Y + 14      ; the group's first window * window length
.const DQ_WL   = DQ_Y + 15      ; windows left in the band
.const DQ_CW   = DQ_Y + 16      ; this window's base
.const DQ_GB   = DQ_Y + 17      ; DQ_G + b
.const DQ_MQ   = DQ_Y + 18      ; the band's largest |q|
.const DQ_NONE = -32767         ; E before any band

; dq_mant(): s1 = mag (1..16383) -> s2 = m, s3 = em, s5 = 4 rem: |q|^(4/3) = m * 2^em * 2^(rem/3).
; Uses s4, s6, s7, s8, s12, s13, A8 and amov's registers (amov clobbers s7: f is made after it).
.macro dq_mant() {
        ldi s12, #128
        alu s12, s12, s1, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; mag > 128
        jmp #3, #3, big
        ldi s4, #DQ_D           ; (delay slot)
        nop()
        alu s4, s4, s1, #OP_ADD
        alu s4, s4, s1, #OP_ADD ; DQ_D + 2 mag
        amov(A8, s4)
        x19.xrd s4, #8          ; m
        x02.ainc #8, #8
        x19.xrd s3, #8          ; em
        alu s2, s4, s0, #OP_ADD
        jmp #ALWAYS, #0, done
        ldi s5, #0              ; (delay slot) rem = 0
        nop()
big:    ldi s6, #1              ; s
        ldi s7, #256            ; 2^(7 + s)
more:   alu s12, s1, s7, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, found
        nop()
        nop()
        alu s6, s6, s14, #OP_ADD
        jmp #ALWAYS, #0, more
        alu s7, s7, s7, #OP_ADD ; (delay slot)
        nop()
found:  alu s8, s6, s14, #OP_SUB
        x19.alu s8, s14, s8, #SHIFT ; 2^(s-1)
        alu s8, s1, s8, #OP_SUB
        alu s12, s0, s6, #OP_SUB
        x19.alu s8, s8, s12, #SHIFT ; j = floor(mag / 2^s)
        ldi s4, #DQ_IT - 64
        alu s4, s4, s8, #OP_ADD
        amov(A8, s4)            ; (clobbers s7)
        x19.alu s12, s8, s6, #SHIFT
        alu s7, s1, s12, #OP_SUB ; f = mag - j 2^s
        x19.xrd s3, #8          ; lo
        x02.ainc #8, #8
        x19.xrd s4, #8          ; hi
        alu s4, s4, s3, #OP_SUB ; d
        ldi s12, #23
        alu s12, s12, s6, #OP_SUB
        x19.alu s7, s7, s12, #SHIFT ; f 2^(23 - s), below 2^23
        x02.mpy s8, s4, s7      ; round(d f / 2^s)
        alu s2, s3, s8, #OP_ADD ; m
        ldi s13, #DQ_IE - 1
        alu s13, s13, s6, #OP_ADD
        x17.mve e6, s13
        ldy s3, e6              ; em
        ldi s13, #DQ_IR - 1
        alu s13, s13, s6, #OP_ADD
        x17.mve e6, s13
        ldy s5, e6              ; 4 rem
done:
}

; s1 = |s11|. Uses s4.
.macro dq_abs() {
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, pos
        alu s1, s11, s0, #OP_ADD ; (delay slot)
        nop()
        alu s1, s0, s11, #OP_SUB
pos:
}

; s7 = floor((sf - 100) / 4) + 2 and s6 = (sf - 100) mod 4, sf at Y:[e8]. Uses s4, s12.
.macro dq_sh() {
        ldy s6, e8
        ldi s4, #100
        alu s6, s6, s4, #OP_SUB ; t
        ldi s4, #2
        alu s7, s6, s4, #OP_SUB
        ldi s12, #-2
        x19.alu s7, s7, s12, #SHIFT ; floor(t / 4)
        x19.alu s12, s7, s4, #SHIFT
        alu s6, s6, s12, #OP_SUB ; b
        alu s7, s7, s4, #OP_ADD ; + 2
}

; The group and band walk both passes share: e7 books, e8 scale factors, e9/e11 the band's
; offsets, e10 the group length. dq_walk_start() resets them.
.macro dq_walk_start() {
        ldi s13, #AAC_BOOK - 1
        x17.mve e7, s13
        ldi s13, #AAC_SF - 1
        x17.mve e8, s13
        ldi s13, #DQ_GLEN - 1
        x17.mve e10, s13
        yld(s3, DQ_GRP)
        yst(DQ_GL)
        ldi s3, #0
        yst(DQ_WB)
}

; Pass 1: Y DQ_E = the largest coefficient exponent, or DQ_NONE.
.macro dq_pass1() {
        ldi s3, #DQ_NONE
        yst(DQ_E)
        dq_walk_start()
grp:    ldi s13, #DQ_OFF - 1
        x17.mve e9, s13
        ldi s13, #DQ_OFF
        x17.mve e11, s13
        yld(s3, DQ_MAX)
        yst(DQ_SL)
band:   yld(s4, DQ_SL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gdone
        nop()
        nop()
        ldy s4, e7
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #LT4, #PTST ; book 0
        jmp #3, #3, bnext
        ldi s12, #10            ; (delay slot) book 12 never reaches here
        alu s4, s12, s4, #OP_SUB ; (delay slot) 11 - book
        ptst p3, s0, #LT4, #PTST ; noise or intensity
        jmp #3, #3, bnext
        ldy s3, e10             ; (delay slot)
        nop()
        yst(DQ_WL)
        yld(s3, DQ_WB)
        yst(DQ_CW)
        ldi s3, #0
        yst(DQ_MQ)
win:    yld(s4, DQ_WL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wdone
        nop()
        nop()
        ldy s5, e9
        ldy s6, e11
        alu s9, s6, s5, #OP_SUB ; coefficients in the band
        yld(s7, DQ_CW)
        alu s7, s7, s5, #OP_ADD
        ldi s4, #DQ_SPEC
        alu s7, s7, s4, #OP_ADD
        amov(A2, s7)
        yld(s10, DQ_MQ)
mx:     alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, mxd
        nop()
        nop()
        x19.xrd s11, #2
        x02.ainc #2, #2
        dq_abs()
        alu s4, s10, s1, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, mx2
        alu s9, s9, s14, #OP_SUB ; (delay slot)
        nop()
        alu s10, s1, s0, #OP_ADD
mx2:    jmp #ALWAYS, #0, mx
        nop()
        nop()
mxd:    alu s3, s10, s0, #OP_ADD
        yst(DQ_MQ)
        yld(s3, DQ_CW)
        yld(s4, DQ_WIN)
        alu s3, s3, s4, #OP_ADD
        yst(DQ_CW)
        yld(s3, DQ_WL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_WL)
        jmp #ALWAYS, #0, win
        nop()
        nop()
wdone:  yld(s1, DQ_MQ)
        alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST ; an all-zero band sets nothing
        jmp #3, #3, bnext
        nop()
        nop()
        dq_mant()
        dq_sh()
        alu s3, s3, s7, #OP_ADD ; e = em + 2 + floor(t / 4)
        yld(s5, DQ_E)
        alu s4, s5, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, bnext
        nop()
        nop()
        yst(DQ_E)
bnext:  x18.eagu e7, e7, #AGU_INC
        x18.eagu e8, e8, #AGU_INC
        x18.eagu e9, e9, #AGU_INC
        x18.eagu e11, e11, #AGU_INC
        yld(s3, DQ_SL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_SL)
        jmp #ALWAYS, #0, band
        nop()
        nop()
gdone:  ldy s5, e10
        yld(s6, DQ_WIN)
        yld(s3, DQ_WB)
gw:     alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gw2
        nop()
        nop()
        alu s3, s3, s6, #OP_ADD
        jmp #ALWAYS, #0, gw
        alu s5, s5, s14, #OP_SUB ; (delay slot)
        nop()
gw2:    yst(DQ_WB)
        x18.eagu e10, e10, #AGU_INC
        yld(s3, DQ_GL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_GL)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
}

; Pass 2: every coefficient of every spectral band to DQ_OUT, shifted to E.
.macro dq_pass2() {
        dq_walk_start()
grp:    ldi s13, #DQ_OFF - 1
        x17.mve e9, s13
        ldi s13, #DQ_OFF
        x17.mve e11, s13
        yld(s3, DQ_MAX)
        yst(DQ_SL)
band:   yld(s4, DQ_SL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gdone
        nop()
        nop()
        ldy s4, e7
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, bnext
        ldi s12, #10            ; (delay slot)
        alu s4, s12, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, bnext
        nop()
        nop()
        dq_sh()
        ldi s3, #DQ_G
        alu s3, s3, s6, #OP_ADD
        yst(DQ_GB)
        yld(s10, DQ_E)
        alu s10, s10, s7, #OP_SUB ; base = E - 2 - floor(t / 4)
        ldy s3, e10
        yst(DQ_WL)
        yld(s3, DQ_WB)
        yst(DQ_CW)
win:    yld(s4, DQ_WL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, bnext
        nop()
        nop()
        ldy s5, e9
        ldy s6, e11
        alu s9, s6, s5, #OP_SUB
        yld(s7, DQ_CW)
        alu s8, s7, s5, #OP_ADD
        ldi s4, #DQ_SPEC
        alu s4, s8, s4, #OP_ADD
        amov(A2, s4)
        ldi s4, #DQ_OUT
        alu s4, s8, s4, #OP_ADD
        amov(A3, s4)
co:     alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, cod
        nop()
        nop()
        x19.xrd s11, #2
        x02.ainc #2, #2
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST ; q = 0: DQ_OUT is already 0
        jmp #3, #3, cnext
        nop()
        nop()
        dq_abs()
        dq_mant()
        yld(s4, DQ_GB)
        alu s4, s4, s5, #OP_ADD
        amov(A9, s4)
        x19.xrd s4, #9          ; G
        x02.mpy s6, s2, s4      ; P
        alu s12, s10, s3, #OP_SUB ; n = E - e
        ldi s4, #24
        alu s4, s12, s4, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, nok
        nop()
        nop()
        ldi s12, #23            ; P < 2^21.75, so any n >= 23 gives 0
nok:    alu s12, s0, s12, #OP_SUB
        x19.alu s6, s6, s12, #SHIFT ; rshr(P, n)
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, put
        nop()
        nop()
        alu s6, s0, s6, #OP_SUB
put:    stx A3, s6
cnext:  x02.ainc #3, #3
        jmp #ALWAYS, #0, co
        alu s9, s9, s14, #OP_SUB ; (delay slot)
        nop()
cod:    yld(s3, DQ_CW)
        yld(s4, DQ_WIN)
        alu s3, s3, s4, #OP_ADD
        yst(DQ_CW)
        yld(s3, DQ_WL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_WL)
        jmp #ALWAYS, #0, win
        nop()
        nop()
bnext:  x18.eagu e7, e7, #AGU_INC
        x18.eagu e8, e8, #AGU_INC
        x18.eagu e9, e9, #AGU_INC
        x18.eagu e11, e11, #AGU_INC
        yld(s3, DQ_SL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_SL)
        jmp #ALWAYS, #0, band
        nop()
        nop()
gdone:  ldy s5, e10
        yld(s6, DQ_WIN)
        yld(s3, DQ_WB)
gw:     alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gw2
        nop()
        nop()
        alu s3, s3, s6, #OP_ADD
        jmp #ALWAYS, #0, gw
        alu s5, s5, s14, #OP_SUB ; (delay slot)
        nop()
gw2:    yst(DQ_WB)
        x18.eagu e10, e10, #AGU_INC
        yld(s3, DQ_GL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_GL)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
}

; dq_channel(): clears DQ_OUT, then both passes; E = 0 when no band has a non-zero value.
.macro dq_channel() {
        aimm(A3, DQ_OUT)
        ldi s9, #1024
clr:    stx A3, s0
        x02.ainc #3, #3
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, clr
        nop()
        nop()
        dq_pass1()
        yld(s4, DQ_E)
        ldi s12, #DQ_NONE
        alu s4, s4, s12, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, run2
        nop()
        nop()
        ldi s3, #0
        yst(DQ_E)
        jmp #ALWAYS, #0, end
        nop()
        nop()
run2:   dq_pass2()
end:
}
