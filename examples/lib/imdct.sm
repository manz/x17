; AAC IMDCT: the x17 twin of sosumi's ref/dsp/aac/imdct.zig `imdct`.
;
; n2 words w with value w * 2^E become 2 n2 samples in PCM units as Q7 words. The words are
; brought to a largest |x| in [2^21, 2^22) (one rounded halving, or doublings counted by
; comparisons), then a pre-twiddle into an n2/2-point complex FFT in bit-reversed order, the
; FFT's stages, a post-twiddle and the fold. cmul is two rounded products summed. Before each
; stage the largest and smallest components decide its scaling: a quarter from 2^22, a half from
; 2^21 (rounded shifts), the shifts joining the exponent. The output shift
; scaled + E' - log2 n2 + 7 is one 0x19 op-23 shift, which saturates as the model's comparisons
; do.
;
; imdct(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT), N4 = n2 / 2 (the FFT's
; points, not a quarter), LOGN2 = log2 n2, STAGES = log2 N4: long (1024, 512, 10, 9), short
; (128, 64, 7, 6).
;   X IN   n2 words in, rewritten (normalised words, then the DCT-IV result u)
;   X Z    n2 words: n4 = n2/2 complex points, re then im
;   X OUT  2 n2 samples out
;   X PRE  exp(-j pi (n + 1/4) / n2), n4 pairs; X POST exp(-j pi k / n2), n4 pairs
;   X TW   the FFT twiddles stage by stage: for size 2, 4, .. n4, the size/2 pairs
;          exp(-j 2 pi i (n4 / size) / n4) for i = 0 .. size/2 - 1 (n4 - 1 pairs in all)
;   Y REV  Z + 2 rev(n) - 2 for n = 0 .. n4 - 1 (rev: log2 n4 bits reversed)
;   Y ESLOT E
; Needs lib/bits.sm (s0 = 0, s14 = 1, p2 clear) and lib/mem.sm. x02.ainc's template also writes
; s2 (its w2 multiply slot) and x02.mpy steps A1, so nothing lives in s2 or A1 here. Uses every s register but s0
; and s14 (s15 is left 16 for bits.sm), e6, e7, R1..R3, R7, A2..A6, A8..A10, A12, A14 and Y
; IM_Y .. IM_Y + 7.

.const IM_Y    = 0x2380
.const IM_EX   = IM_Y + 0       ; E of the normalised words
.const IM_SC   = IM_Y + 1       ; FFT scaling so far
.const IM_HALF = IM_Y + 2       ; the stage's size / 2
.const IM_GRPS = IM_Y + 3       ; the stage's groups, n4 / size
.const IM_PJ   = IM_Y + 4       ; Z + 2 j
.const IM_STG  = IM_Y + 5       ; stages left
.const IM_J    = IM_Y + 6       ; twiddles left in the stage

; s10 = max(0, X[BASE ..]), s11 = min(0, X[BASE ..]) over COUNT words. Uses s1, s4, s9, A8, p3.
.macro im_scan(BASE, COUNT) {
        aimm(A8, BASE)
        ldi s9, #COUNT
        ldi s10, #0
        ldi s11, #0
mm:     x19.xrd s1, #8
        x02.ainc #8, #8
        alu s4, s1, s10, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        psel s10, s4, s10, p3, #0, #4 ; x > max: max + (x - max)
        alu s4, s1, s11, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        psel s11, s4, s11, p3, #1, #4 ; x < min: min + (x - min)
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, mm
        nop()
        nop()
}

; s6 = 2 when MX >= 2^22 or MN <= -2^22, else 1 when MX >= 2^21 or MN <= -2^21, else 0.
; Uses s3, s4, p3.
.macro im_decide(MX, MN) {
        ldi s3, #22
        x19.alu s3, s14, s3, #SHIFT ; 2^22
        alu s4, MX, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, two    ; max >= 2^22
        alu s4, MN, s3, #OP_ADD ; (delay slot)
        nop()
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, two         ; min <= -2^22
        ldi s3, #21             ; (delay slot)
        x19.alu s3, s14, s3, #SHIFT ; (delay slot) 2^21
        alu s4, MX, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, one
        alu s4, MN, s3, #OP_ADD ; (delay slot)
        nop()
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, one
        nop()
        nop()
        jmp #IF_NOT, #2, done
        ldi s6, #0              ; (delay slot)
        nop()
two:    jmp #IF_NOT, #2, done
        ldi s6, #2              ; (delay slot)
        nop()
one:    ldi s6, #1
done:
}

; X[BASE ..] = shift23(X[BASE ..], s6) over COUNT words: s6 < 0 a rounded right shift. Uses s1,
; s4, s9, A8, A9 and aimm's registers.
.macro im_shift(BASE, COUNT) {
        aimm(A8, BASE)
        aimm(A9, BASE)
        ldi s9, #COUNT
sl:     x19.xrd s1, #8
        x02.ainc #8, #8
        x19.alu s1, s1, s6, #SHIFT
        stx A9, s1
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, sl
        nop()
        nop()
}

; Normalise IN; the zero block clears OUT and jumps to SILENT.
.macro im_norm(N2, IN, OUT, ESLOT, SILENT) {
        im_scan(IN, N2)
        alu s1, s0, s11, #OP_SUB ; -min
        alu s4, s1, s10, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, havebig
        alu s5, s10, s0, #OP_ADD ; (delay slot) big = max
        nop()
        alu s5, s1, s0, #OP_ADD ; big = -min
havebig: alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, nonzero
        nop()
        nop()
        aimm(A9, OUT)
        ldi s9, #2 * N2
clr:    stx A9, s0
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, clr
        nop()
        nop()
        jmp #IF_NOT, #2, SILENT
        nop()
        nop()
nonzero: im_decide(s10, s11)
        ldi s4, #2
        alu s4, s6, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST ; big >= 2^22: one rounded halving
        jmp #3, #3, scale
        ldi s6, #-1             ; (delay slot)
        nop()
        ldi s6, #0
        ldi s3, #21
        x19.alu s3, s14, s3, #SHIFT ; 2^21
dbl:    alu s4, s5, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, scale
        nop()
        nop()
        alu s5, s5, s5, #OP_ADD
        jmp #IF_NOT, #2, dbl
        alu s6, s6, s14, #OP_ADD ; (delay slot)
        nop()
scale:  yld(s3, ESLOT)
        alu s3, s3, s6, #OP_SUB
        yst(IM_EX)              ; E' = E - count
        im_shift(IN, N2)
}

; s7 = max(s7, V), s13 = min(s13, V). Uses s4, p3.
.macro im_track(V) {
        alu s4, V, s7, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        psel s7, s4, s7, p3, #0, #4
        alu s4, V, s13, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        psel s13, s4, s13, p3, #1, #4
}

; A<2k> = the value s<src> + 2 (mem.sm's amov path without its first two steps): e6, R7.
.macro im_aset(src, k) {
        x17.mve e6, src
        x19.a3 s0, R7, e6, #25, #2, #0
        x12.aset #k, R7
}

; Z[rev n] = (IN[2n], IN[n2 - 1 - 2n]) * PRE[n], tracking the largest and smallest component in
; s7 and s13. Y REV holds Z + 2 rev(n) - 2.
.macro im_pre(N2, N4, IN, PRE, REV) {
        ldi s12, #IN
        amov(A4, s12)
        ldi s12, #IN + N2 - 1
        amov(A6, s12)
        aimm(A8, PRE)
        ldi s13, #REV - 1
        x17.mve e7, s13         ; e7 = REV
        rimm R2, #-2
        ldi s11, #N4
        ldi s7, #0
        ldi s13, #0
pre:    x19.xrd s1, #4          ; xr
        x02.ainc #4, #4
        x02.ainc #4, #4
        x19.xrd s12, #6         ; xi
        x18.rag101 s0, R3, A6, R2, #2
        x12.aset #3, R3
        x19.xrd s3, #8          ; pr
        x02.ainc #8, #8
        x19.xrd s5, #8          ; pi
        x02.ainc #8, #8
        x02.mpy s6, s1, s3
        x02.mpy s8, s12, s5
        alu s6, s6, s8, #OP_SUB ; re
        x02.mpy s8, s1, s5
        x02.mpy s9, s12, s3
        alu s8, s8, s9, #OP_ADD ; im
        ldy s10, e7
        x18.eagu e7, e7, #AGU_INC
        im_aset(s10, 6)
        stx A12, s6
        x02.ainc #12, #12
        stx A12, s8
        im_track(s6)
        im_track(s8)
        alu s11, s11, s14, #OP_SUB
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, pre
        nop()
        nop()
}

; RD = s<src> (the R write path of mem.sm's amov). Uses s13, e6.
.macro im_rset(src, RD) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, RD, e6, #25, #2, #0
}

; dst = shift23(X[A an], s12), A an + 1.
.macro im_ld(dst, an) {
        x19.xrd dst, #an
        x02.ainc #an, #an
        x19.alu dst, dst, s12, #SHIFT
}

; X[AN] = V, AN + 1 (an its number), and V tracked.
.macro im_st(AN, an, V) {
        stx AN, V
        x02.ainc #an, #an
        im_track(V)
}

; The FFT's stages over Z, twiddles from A5. Each stage's scaling comes from the largest and
; smallest components the stage before wrote (s7, s13; the pre-twiddle's for the first) and is
; applied as each butterfly loads its inputs.
.macro im_fft(N4, Z, TW, STAGES) {
        im_decide(s7, s13)
        aimm(A5, TW)
        rimm R5, #2
        ldi s3, #1
        yst(IM_HALF)
        ldi s3, #N4 / 2
        yst(IM_GRPS)
        ldi s3, #0
        yst(IM_SC)
        ldi s3, #STAGES
        yst(IM_STG)
stage:  yld(s3, IM_SC)
        alu s3, s3, s6, #OP_ADD
        yst(IM_SC)
        alu s12, s0, s6, #OP_SUB ; the load shift
        yld(s1, IM_HALF)
        alu s1, s1, s1, #OP_ADD
        im_rset(s1, R4)         ; 2 half
        alu s1, s1, s1, #OP_ADD
        alu s1, s1, s14, #OP_SUB
        alu s1, s1, s14, #OP_SUB
        im_rset(s1, R1)         ; 2 size - 2
        ldi s3, #Z
        amov(A2, s3)            ; Z + 2 j
        yld(s3, IM_HALF)
        yst(IM_J)
        ldi s13, #IM_J - 1
        x17.mve e8, s13
        ldi s13, #IM_GRPS - 1
        x17.mve e9, s13
        ldi s7, #0
        ldi s13, #0
tw:     x19.xrd s10, #5         ; wr
        x02.ainc #5, #5
        x19.xrd s11, #5         ; wi
        x02.ainc #5, #5
        x18.rag101 s0, R3, A2, R4, #5
        x12.aset #2, R3         ; A4 = Z + 2 j
        x12.aset #5, R3         ; A10
        x18.rag101 s0, R3, A2, R4, #2
        x12.aset #3, R3         ; A6 = Z + 2 j + 2 half
        x12.aset #6, R3         ; A12
        ldy s15, e9
bf:     im_ld(s1, 4)            ; ar
        im_ld(s8, 4)            ; ai
        im_ld(s3, 6)            ; br
        im_ld(s5, 6)            ; bi
        x02.mpy s6, s3, s10
        x02.mpy s9, s5, s11
        alu s6, s6, s9, #OP_SUB ; tr
        x02.mpy s9, s3, s11
        x02.mpy s3, s5, s10
        alu s9, s9, s3, #OP_ADD ; ti
        alu s3, s1, s6, #OP_ADD
        im_st(A10, 10, s3)
        alu s3, s8, s9, #OP_ADD
        im_st(A10, 10, s3)
        alu s3, s1, s6, #OP_SUB
        im_st(A12, 12, s3)
        alu s3, s8, s9, #OP_SUB
        im_st(A12, 12, s3)
        x18.rag101 s0, R3, A4, R1, #2
        x12.aset #2, R3
        x18.rag101 s0, R3, A6, R1, #2
        x12.aset #3, R3
        x18.rag101 s0, R3, A10, R1, #2
        x12.aset #5, R3
        x18.rag101 s0, R3, A12, R1, #2
        x12.aset #6, R3
        alu s15, s15, s14, #OP_SUB
        alu s4, s15, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, bf
        nop()
        nop()
        x18.rag101 s0, R3, A2, R5, #2
        x12.aset #1, R3         ; j + 1
        ldy s4, e8
        alu s4, s4, s14, #OP_SUB
        x17.sty e8, #4, #0
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, tw
        nop()
        nop()
        im_decide(s7, s13)
        yld(s3, IM_HALF)
        alu s3, s3, s3, #OP_ADD
        yst(IM_HALF)
        yld(s3, IM_GRPS)
        ldi s4, #-1
        x19.alu s3, s3, s4, #SHIFT ; groups / 2 (even, so the rounding is exact)
        yst(IM_GRPS)
        yld(s3, IM_STG)
        alu s3, s3, s14, #OP_SUB
        yst(IM_STG)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, stage
        nop()
        nop()
}

; u[2k] = re(Z[k] POST[k]), u[n2 - 1 - 2k] = -im(Z[k] POST[k]), u over IN.
.macro im_post(N2, N4, Z, IN, POST) {
        aimm(A4, Z)
        aimm(A8, POST)
        ldi s12, #IN
        amov(A10, s12)
        ldi s12, #IN + N2 - 1
        amov(A12, s12)
        rimm R2, #-2
        ldi s11, #N4
post:   x19.xrd s1, #4          ; er
        x02.ainc #4, #4
        x19.xrd s12, #4         ; ei
        x02.ainc #4, #4
        x19.xrd s3, #8          ; pr
        x02.ainc #8, #8
        x19.xrd s5, #8          ; pi
        x02.ainc #8, #8
        x02.mpy s6, s1, s3
        x02.mpy s8, s12, s5
        alu s6, s6, s8, #OP_SUB ; re
        x02.mpy s8, s1, s5
        x02.mpy s9, s12, s3
        alu s8, s8, s9, #OP_ADD ; im
        stx A10, s6
        x02.ainc #10, #10
        x02.ainc #10, #10
        alu s8, s0, s8, #OP_SUB
        stx A12, s8
        x18.rag101 s0, R3, A12, R2, #2
        x12.aset #6, R3
        alu s11, s11, s14, #OP_SUB
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, post
        nop()
        nop()
}

; COUNT samples OUT.. <- shift23(v, s6), v = alu(X, Y, OP) of s1 = X[A8], A8 stepping by R2.
.macro im_fold_run(COUNT, X, Y, OP) {
        ldi s9, #COUNT
fr:     x19.xrd s1, #8
        x18.rag101 s0, R3, A8, R2, #2
        x12.aset #4, R3
        alu s1, X, Y, OP
        x19.alu s1, s1, s6, #SHIFT
        stx A9, s1
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, fr
        nop()
        nop()
}

; OUT[n] = shiftSat(fold(u)[n], scaled + E' - log2 n2 + 7).
.macro im_fold(N2, LOGN2, IN, OUT) {
        yld(s6, IM_SC)
        yld(s3, IM_EX)
        alu s6, s6, s3, #OP_ADD
        ldi s3, #7 - LOGN2
        alu s6, s6, s3, #OP_ADD
        aimm(A9, OUT)
        ldi s12, #IN + N2 / 2
        amov(A8, s12)
        rimm R2, #1
        im_fold_run(N2 / 2, s1, s0, #OP_ADD)
        ldi s12, #IN + N2 - 1
        amov(A8, s12)
        rimm R2, #-1
        im_fold_run(N2, s0, s1, #OP_SUB)
        aimm(A8, IN)
        rimm R2, #1
        im_fold_run(N2 / 2, s0, s1, #OP_SUB)
}

.macro imdct(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT) {
        im_norm(N2, IN, OUT, ESLOT, silent)
        im_pre(N2, N4, IN, PRE, REV)
        im_fft(N4, Z, TW, STAGES)
        im_post(N2, N4, Z, IN, POST)
        im_fold(N2, LOGN2, IN, OUT)
silent: ldi s15, #16
}
