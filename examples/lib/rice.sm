; ALAC's adaptive Golomb-Rice codeword: the x17 twin of `get` in sosumi's
; ref/dsp/alac/rice.zig. Needs lib/bits.sm included first.
;
; rice_get(dst): s1 = m, s2 = k (1..15), s3 = escape width (<= 22); dst gets the value.
;   A prefix of 9 ones is an escape: the next s3 bits, raw.
;   Otherwise, pre ones then a zero; hi = the next k - 1 bits; with base = pre * m,
;   hi == 0 gives base, else base + 2 * hi + bit - 1.
; Uses s4 (as dst), s5, s7, s8; s1..s3 survive.
;
; The prefix bits come straight off the cache (subtract 2^(avail - 1), test the sign). hi
; and its bit are read as one k-bit v = 2 * hi + bit: v >= 2 gives base + v - 1, and v < 2
; (hi == 0) gives base with v's bit handed back to the cache. base is one exact multiply,
; round((m << 8) * (pre << 15) / 2^23), m < 2^15, pre <= 8.

.const MAX_PREFIX = 9

; dst = the next n bits, n in s7 (1..16), read as at most two getbits_s. Uses s5, s11.
.macro readk(dst) {
        ldi s11, #8
        alu s5, s7, s11, #OP_SUB ; n - 8
        ptst p1, s5, #NEG, #PTST ; n < 8
        jmp #3, #1, short
        nop()
        nop()
        getbits_s(dst)          ; the top 8
        alu s11, s5, s0, #OP_ADD
        getbits_s(s5)           ; the other n - 8
        x19.alu dst, dst, s11, #SHIFT
        alu dst, dst, s5, #OP_ADD
        jmp #IF_NOT, #2, done
        nop()
        nop()
short:  alu s11, s7, s0, #OP_ADD
        getbits_s(dst)
done:
}

.macro rice_get(dst) {
        alu s8, s0, s14, #OP_SUB ; pre = -1: the delay slot counts each bit
pfx:    alu s12, s10, s14, #OP_SUB ; sh = avail - 1
        ptst p1, s12, #NEG, #PTST ; cache empty
        jmp #IF_NOT, #1, pbit
        ldy s13, e5             ; (delay slot) next word
        nop()
        x19.alu s9, s9, s15, #SHIFT ; refill
        alu s9, s9, s13, #OP_ADD
        x18.eagu e5, e5, #AGU_INC
        alu s10, s10, s15, #OP_ADD
        alu s12, s10, s14, #OP_SUB
pbit:   x19.alu s13, s14, s12, #SHIFT ; 2^sh
        alu s13, s9, s13, #OP_SUB
        alu s10, s12, s0, #OP_ADD ; avail -= 1
        ptst p1, s13, #NEG, #PTST ; the bit is 0
        jmp #3, #1, gotpre
        alu s8, s8, s14, #OP_ADD ; (delay slot) pre += 1
        ldi s7, #MAX_PREFIX - 1 ; (delay slot)
        alu s9, s13, s0, #OP_ADD ; the 1 leaves the cache
        alu s7, s8, s7, #OP_SUB
        ptst p1, s7, #NEG, #PTST ; fewer than 9 ones so far
        jmp #3, #1, pfx
        nop()
        nop()
        alu s7, s3, s0, #OP_ADD ; escape: n = escape width
        readn(dst)
        jmp #IF_NOT, #2, done
        nop()
        nop()
gotpre: ldi s5, #8
        x19.alu s5, s1, s5, #SHIFT ; m << 8
        ldi s7, #15
        x19.alu s7, s8, s7, #SHIFT ; pre << 15
        x02.mpy s8, s5, s7      ; base = pre * m
        alu s7, s2, s0, #OP_ADD
        readk(dst)              ; v
        alu s5, dst, s14, #OP_SUB
        alu s5, s5, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; v < 2: hi == 0
        jmp #IF_NOT, #1, big
        alu s7, dst, s8, #OP_ADD ; (delay slot) base + v
        alu s7, s7, s14, #OP_SUB ; (delay slot) - 1
        x19.alu s5, dst, s10, #SHIFT ; v's bit back on top of the cache
        alu s9, s9, s5, #OP_ADD
        alu s10, s10, s14, #OP_ADD
        alu dst, s8, s0, #OP_ADD ; base
        jmp #IF_NOT, #2, done
        nop()
        nop()
big:    alu dst, s7, s0, #OP_ADD
done:
}

; ---------------------------------------------------------------------------
; rice_decompress: the adaptive loop, the x17 twin of sosumi's `rice.decompress`.
;
; State lives in Y slots (every value fits 16 bits), pointed at by e registers that
; rice_slots(base) sets up; the caller fills them before the loop:
;
;   e1  Y:base+0  mean hi    the mean mb = hi * 2^15 + lo, lo in [0, 2^15)
;   e2  Y:base+1  mean lo
;   e3  Y:base+2  zmode
;   e4  Y:base+3  samples left
;   e7  Y:base+4  pb (<= 127)
;   e8  Y:base+5  kb (1..15)
;   e9  Y:base+6  max_bits (<= 22), the escape width
;   e10 Y:base+7  error: set to 1 when a zero run overruns (the model's RunTooLong)
;   e6  Y:base+8  scratch: the last k, where the next sample's search starts
;
; Residuals go to X:[A6], A6 advancing by one each (x02.ainc, which also overwrites s2
; through its bundle's multiply slot). Products are exact single
; multiplies: round((pb << 16) * (x << 7) / 2^23) = pb * x for pb < 2^7, x < 2^16.

.macro rice_slots(base) {
        ldi s5, #base - 1
        x17.mve e1, s5
        ldi s5, #base
        x17.mve e2, s5
        ldi s5, #base + 1
        x17.mve e3, s5
        ldi s5, #base + 2
        x17.mve e4, s5
        ldi s5, #base + 3
        x17.mve e7, s5
        ldi s5, #base + 4
        x17.mve e8, s5
        ldi s5, #base + 5
        x17.mve e9, s5
        ldi s5, #base + 6
        x17.mve e10, s5
}

; dst = floor(x / 2^n) for x >= -2^22, n in 1..15 (ldi sign-extends 2^15). Uses s6.
.macro floorshr(dst, x, n) {
        ldi s6, #1 << (n - 1)
        alu dst, x, s6, #OP_SUB
        ldi s6, #-n
        x19.alu dst, dst, s6, #SHIFT
}

.macro rice_decompress(base) {
        ldi s5, #base + 7
        x17.mve e6, s5
        x17.sty e6, #6, #1      ; k = 1 (s14)
top:    ldy s7, e4
        alu s5, s7, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = no samples left
        jmp #3, #1, finish
        nop()
        nop()
        ; k = min(floor(log2(q + 3)), kb), q = floor(mb / 2^9) = hi * 2^6 + floor(lo / 2^9)
        ldy s1, e1
        ldi s5, #6
        x19.alu s1, s1, s5, #SHIFT
        ldy s2, e2
        floorshr(s2, s2, 9)
        alu s1, s1, s2, #OP_ADD
        ldi s5, #3
        alu s1, s1, s5, #OP_ADD ; y = q + 3
        ldy s8, e8              ; kb
        ldy s2, e6              ; k from the last sample (y >= 3, so k >= 1 holds)
lgd:    x19.alu s7, s14, s2, #SHIFT ; 2^k
        alu s7, s1, s7, #OP_SUB
        ptst p1, s7, #NEG, #PTST ; y < 2^k: down one
        jmp #IF_NOT, #1, lg
        alu s5, s2, s14, #OP_SUB ; (delay slot) k - 1
        nop()
        alu s2, s5, s0, #OP_ADD
        jmp #IF_NOT, #2, lgd
        nop()
        nop()
lg:     alu s5, s2, s14, #OP_ADD ; t = k + 1
        alu s7, s8, s5, #OP_SUB
        ptst p1, s7, #NEG, #PTST ; t > kb: stop
        jmp #3, #1, lgdone
        x19.alu s7, s14, s5, #SHIFT ; (delay slot) 2^t
        alu s7, s1, s7, #OP_SUB ; (delay slot) y - 2^t
        ptst p1, s7, #NEG, #PTST ; y < 2^t: stop
        jmp #3, #1, lgdone
        nop()
        nop()
        alu s2, s5, s0, #OP_ADD ; k = t
        jmp #IF_NOT, #2, lg
        nop()
        nop()
lgdone: x17.sty e6, #2, #0      ; keep k
        x19.alu s1, s14, s2, #SHIFT
        alu s1, s1, s14, #OP_SUB ; m = 2^k - 1
        ldy s3, e9
        rice_get(s4)            ; n
        ldy s5, e3
        alu s7, s4, s5, #OP_ADD ; nd = n + zmode
        ; residual: mag = floor((nd + 1) / 2) = rshr(nd, 1), negated when nd is odd
        alu s6, s0, s14, #OP_SUB
        x19.alu s8, s7, s6, #SHIFT ; mag
        alu s5, s8, s8, #OP_ADD
        alu s5, s5, s7, #OP_SUB ; 2 mag - nd: 1 when odd
        alu s5, s5, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = even
        jmp #3, #1, even
        alu s6, s0, s8, #OP_SUB ; (delay slot) -mag
        nop()
        alu s8, s6, s0, #OP_ADD
even:   stx A6, s8
        x02.ainc #6, #6
        ldy s5, e4
        alu s5, s5, s14, #OP_SUB
        x17.sty e4, #5, #0      ; left -= 1
        ; the mean: n >= 2^16 clamps it to 0xFFFF
        x19.alu s5, s14, s15, #SHIFT
        alu s5, s4, s5, #OP_SUB
        ptst p1, s5, #NEG, #PTST
        jmp #3, #1, grow
        nop()
        nop()
        x17.sty e1, #6, #1      ; hi = 1 (s14)
        ldi s5, #0x7FFF
        x17.sty e2, #5, #0
        jmp #IF_NOT, #2, zchk
        nop()
        nop()
        ; mb += pb * nd - floor(pb * mb / 2^9), with
        ; floor(pb * mb / 2^9) = (pb * hi) << 6 + floor(pb * lo / 2^9)
grow:   ldy s6, e7
        x19.alu s6, s6, s15, #SHIFT ; pb << 16
        ldi s11, #7
        alu s5, s7, s14, #OP_SUB ; nd - 1 < 2^16 (nd reaches 2^16)
        x19.alu s5, s5, s11, #SHIFT
        x02.mpy s1, s6, s5      ; pb * (nd - 1)
        ldy s5, e7
        alu s1, s1, s5, #OP_ADD ; pb * nd
        ldy s7, e1              ; hi
        ldy s8, e2              ; lo
        x19.alu s2, s7, s11, #SHIFT
        x02.mpy s3, s6, s2
        ldi s5, #6
        x19.alu s3, s3, s5, #SHIFT ; (pb * hi) << 6
        x19.alu s2, s8, s11, #SHIFT
        x02.mpy s4, s6, s2
        floorshr(s4, s4, 9)
        alu s3, s3, s4, #OP_ADD ; decay
        alu s1, s1, s3, #OP_SUB ; x = pb * nd - decay
        floorshr(s3, s1, 15)    ; x hi
        ldi s5, #15
        x19.alu s4, s3, s5, #SHIFT ; (x hi) << 15, |x hi| <= 2^8
        alu s4, s1, s4, #OP_SUB ; x lo
        alu s1, s7, s3, #OP_ADD ; hi + x hi
        alu s2, s8, s4, #OP_ADD ; lo + x lo, below 2^16
        floorshr(s3, s2, 15)    ; carry, 0 or 1
        alu s1, s1, s3, #OP_ADD
        x19.alu s3, s3, s5, #SHIFT ; carry << 15 (s5 = 15)
        alu s2, s2, s3, #OP_SUB
        x17.sty e1, #1, #0
        x17.sty e2, #2, #0
        ; a zero run follows when mb < 128 and samples are left
zchk:   ldi s5, #0
        x17.sty e3, #5, #0      ; zmode = 0
        ldy s1, e1
        alu s5, s1, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = hi == 0
        jmp #IF_NOT, #1, top
        ldy s2, e2              ; (delay slot) lo
        ldi s5, #128            ; (delay slot)
        alu s5, s2, s5, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = lo < 128
        jmp #IF_NOT, #1, top
        ldy s7, e4              ; (delay slot) left
        alu s5, s7, s14, #OP_SUB ; (delay slot)
        ptst p1, s5, #NEG, #PTST ; p1 = none left
        jmp #3, #1, finish
        nop()
        nop()
        x17.sty e3, #6, #1      ; zmode = 1 (s14)
        ; kz = 8 - bitlen(lo) + floor((lo + 16) / 2^6)
        ldi s3, #0              ; bitlen
bl:     ldi s5, #7
        alu s5, s3, s5, #OP_SUB
        ptst p1, s5, #NEG, #PTST
        jmp #IF_NOT, #1, bldone ; bitlen == 7
        x19.alu s5, s14, s3, #SHIFT ; (delay slot) 2^bitlen
        alu s5, s2, s5, #OP_SUB ; (delay slot) lo - 2^bitlen
        ptst p1, s5, #NEG, #PTST
        jmp #3, #1, bldone
        nop()
        nop()
        alu s3, s3, s14, #OP_ADD
        jmp #IF_NOT, #2, bl
        nop()
        nop()
bldone: ldi s5, #16
        alu s5, s2, s5, #OP_ADD
        floorshr(s5, s5, 6)
        ldi s2, #8
        alu s2, s2, s3, #OP_SUB
        alu s2, s2, s5, #OP_ADD ; k = kz
        ; mz = 2^min(kz, kb) - 1
        ldy s8, e8
        alu s5, s8, s2, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = kb < kz
        jmp #3, #1, kbmin
        alu s1, s2, s0, #OP_ADD ; (delay slot) min = kz
        nop()
        jmp #IF_NOT, #2, mz
        nop()
        nop()
kbmin:  alu s1, s8, s0, #OP_ADD ; min = kb
mz:     x19.alu s1, s14, s1, #SHIFT
        alu s1, s1, s14, #OP_SUB
        alu s3, s15, s0, #OP_ADD ; escape width 16
        rice_get(s4)            ; run
        ldy s7, e4
        alu s5, s7, s4, #OP_SUB ; left - run
        ptst p1, s5, #NEG, #PTST
        jmp #3, #1, overrun
        nop()
        nop()
        x17.sty e4, #5, #0      ; left -= run
        alu s7, s4, s0, #OP_ADD
zrun:   alu s5, s7, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = all written
        jmp #3, #1, zdone
        nop()
        nop()
        alu s8, s0, s0, #OP_ADD
        stx A6, s8
        x02.ainc #6, #6
        alu s7, s7, s14, #OP_SUB
        jmp #IF_NOT, #2, zrun
        nop()
        nop()
zdone:  ldi s5, #0x7FFF
        alu s5, s5, s5, #OP_ADD ; 0xFFFE
        alu s5, s5, s14, #OP_ADD ; 65535
        alu s5, s4, s5, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; p1 = run < 65535
        jmp #3, #1, keepz
        ldi s5, #0              ; (delay slot)
        nop()
        x17.sty e3, #5, #0      ; zmode = 0
keepz:  x17.sty e1, #5, #0      ; mb = 0
        x17.sty e2, #5, #0
        jmp #IF_NOT, #2, top
        nop()
        nop()
overrun: x17.sty e10, #6, #1    ; error = 1
finish:
}
