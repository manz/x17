; ALAC's adaptive predictor: the x17 twin of `unpredict` in sosumi's ref/dsp/alac/predictor.zig.
; Needs lib/bits.sm (constants, nop, s14 = 1, p2 clear) and lib/rice.sm (floorshr) first.
;
; Arrays are 24-bit X words walked upward through A registers:
;   A2   residuals pc[0..n)           (read)
;   A3   samples out[0..n)            (written)
;   A10  coefficients, REVERSED: X:[A10 + i] = coefs[order - 1 - i], adapted in place
; Walking the coefficients reversed lets every access ascend: the sum over k does not
; care about order, and the adaptation visits k = order - 1 down to 0, i.e. i upward.
; A4, A7, A8, A9, A11 are scratch. A1 is avoided: every x02 bundle runs its A slot, and the
; multiply templates name A1 there, so each x02.mpy / x02.x3 also does A1 += 1 (own-x02mpy-a1).
;
; Y slots (pred_slots(base)), filled by the caller:
;   e11 Y:base+0  n
;   e12 Y:base+1  order (0..31)
;   e13 Y:base+2  den_shift (0..15)
;   e14 Y:base+3  chan_bits (8..23, with den_shift + chan_bits <= 32, chan_bits <= 18 + den_shift)
;   e15 Y:base+4  scratch: samples left
;
; Keeps the bit reader (e5, s9, s10) and s14, s15. Uses every other s register; unpredict
; parks s9 and s10 at X:[A10 + 32], +33 (past the 31 coefficients; Y is 16 bits, the cache
; is not) to hold the tap loop's constants there, through A5.
; Shifts by a runtime count wrap by doubling (alu add wraps; the 0x19 shift saturates).

.macro pred_slots(base) {
        ldi s5, #base - 1
        x17.mve e11, s5
        ldi s5, #base
        x17.mve e12, s5
        ldi s5, #base + 1
        x17.mve e13, s5
        ldi s5, #base + 2
        x17.mve e14, s5
        ldi s5, #base + 3
        x17.mve e15, s5
}

; x <<= cnt, wrapping at 24 bits; cnt (>= 0) is consumed. Uses s6.
.macro shlw(x, cnt) {
again:  alu s6, cnt, s14, #OP_SUB
        ptst p1, s6, #NEG, #PTST ; p1 = cnt == 0
        jmp #3, #1, done
        nop()
        nop()
        alu x, x, x, #OP_ADD
        alu cnt, cnt, s14, #OP_SUB
        jmp #IF_NOT, #2, again
        nop()
        nop()
done:
}

; x = x sign-extended from its low k bits, k (8..24) in the Y slot `slot`. Uses s6, s12, s13.
; (x << s) is a multiple of 2^s, so the rounded right shift by s is exact.
.macro sxe(x, slot) {
        ldy s13, slot
        ldi s12, #24
        alu s13, s12, s13, #OP_SUB ; s = 24 - k
        alu s12, s0, s13, #OP_SUB ; -s
        shlw(x, s13)
        x19.alu x, x, s12, #SHIFT
}

; sxe from chan_bits.
.macro sxcb(x) {
        sxe(x, e14)
}

; dst = floor(v / 2^n), n (0..15) in a register: rshr(v - h, n), h = rshr(2^n - 1, 1).
; v must leave room for the subtraction (|v| < 2^23 - 2^14). Uses s6.
.macro floorn(dst, v, n) {
        x19.alu s6, s14, n, #SHIFT ; 2^n
        alu s6, s6, s14, #OP_SUB
        alu dst, s0, s14, #OP_SUB ; -1 (dst is free until the end)
        x19.alu s6, s6, dst, #SHIFT ; h
        alu dst, v, s6, #OP_SUB
        alu s6, s0, n, #OP_SUB
        x19.alu dst, dst, s6, #SHIFT
}

; buf[j] = buf[j] + buf[j - 1] sign-extended from chan_bits, in place over X:[A2..A2+n)
; (mode != 0, the twin of `predictor.integrate`). Reads the pred_slots n and chan_bits; leaves
; A2 past the buffer. Uses s1, s3, s4, s6, s12, s13; counts in s1 (x02.ainc writes s2).
.macro integrate() {
        ldy s1, e11
        alu s4, s1, s14, #OP_SUB
        ptst p1, s4, #NEG, #PTST ; n == 0
        jmp #3, #1, done
        nop()
        nop()
        x19.xrd s4, #2          ; prev = buf[0]
        x02.ainc #2, #2
        alu s1, s1, s14, #OP_SUB
next:   alu s3, s1, s14, #OP_SUB
        ptst p1, s3, #NEG, #PTST
        jmp #3, #1, done
        nop()
        nop()
        x19.xrd s3, #2
        alu s3, s3, s4, #OP_ADD
        sxcb(s3)
        stx A2, s3
        x02.ainc #2, #2
        alu s4, s3, s0, #OP_ADD
        alu s1, s1, s14, #OP_SUB
        jmp #IF_NOT, #2, next
        nop()
        nop()
done:
}

; The adaptation's registers: A9 = out[j - order], A11 = the reversed coefficients,
; s8 = order steps, s9 = h = rshr(2^ds - 1, 1), s10 = -ds (floor(v / 2^ds) = rshr(v - h, ds)),
; s11 = 5, s6 = 2^15 - 1, s1 = 2^18, s4 = w << 18 (w = 1), s3 = the first out. Uses s2.
.macro adapt_init() {
        x19.aagu5 A9, A7, #5, #0
        x19.aagu5 A11, A10, #5, #0
        ldy s8, e12
        ldy s2, e13
        x19.alu s9, s14, s2, #SHIFT ; 2^ds
        alu s10, s0, s2, #OP_SUB ; -ds
        alu s9, s9, s14, #OP_SUB
        alu s2, s0, s14, #OP_SUB
        x19.alu s9, s9, s2, #SHIFT ; h
        ldi s11, #5
        ldi s6, #0x7FFF
        ldi s1, #18
        x19.alu s1, s14, s1, #SHIFT ; 2^18
        alu s4, s1, s0, #OP_ADD
        x19.xrd s3, #9
        x02.ainc #9, #9
}

.macro unpredict() {
        x03.agu A5, A10, #32, #0, A0 ; park the bit reader
        stx A5, s9
        x02.ainc #5, #5
        stx A5, s10
        ldi s9, #1 << 14        ; tap constants
        ldi s10, #-15
        ldi s11, #8
        ldy s7, e11
        alu s5, s7, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; n == 0
        jmp #3, #1, finish
        x19.aagu5 A4, A3, #5, #0 ; (delay slot) A4 = out base
        nop()
        x19.xrd s1, #2          ; out[0] = pc[0]
        x02.ainc #2, #2
        stx A3, s1
        x02.ainc #3, #3
        alu s7, s7, s14, #OP_SUB ; left = n - 1
        ldy s8, e12             ; warm-up count = order
        ; out[j] = sx(pc[j] + out[j - 1]) for j = 1 .. min(order, n - 1)
warm:   alu s5, s7, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; nothing left
        jmp #3, #1, finish
        nop()
        nop()
        alu s5, s8, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; warm-up done
        jmp #3, #1, main
        nop()
        nop()
        x19.xrd s3, #2
        x02.ainc #2, #2
        alu s1, s3, s1, #OP_ADD
        sxcb(s1)
        stx A3, s1
        x02.ainc #3, #3
        alu s7, s7, s14, #OP_SUB
        alu s8, s8, s14, #OP_SUB
        jmp #IF_NOT, #2, warm
        nop()
        nop()
        ; order == 0 lands here with j = 1 and copies (the sum below is empty, so
        ; out[j] = sx(pc[j] + top); handled apart to match the reference's plain copy)
main:   x17.sty e15, #7, #0     ; left
        ldy s8, e12
        alu s5, s8, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; order == 0
        jmp #IF_NOT, #1, window
        nop()
        nop()
copy:   ldy s7, e15
        alu s5, s7, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST
        jmp #3, #1, finish
        nop()
        nop()
        x19.xrd s1, #2
        x02.ainc #2, #2
        stx A3, s1
        x02.ainc #3, #3
        alu s7, s7, s14, #OP_SUB
        x17.sty e15, #7, #0
        jmp #IF_NOT, #2, copy
        nop()
        nop()
window: x19.aagu5 A8, A4, #5, #0 ; top: out[j - order - 1]
        x19.aagu5 A7, A4, #5, #0
        x02.ainc #7, #7         ; history: out[j - order]
sample: ldy s7, e15
        alu s5, s7, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST
        jmp #3, #1, finish
        nop()
        nop()
        x19.xrd s7, #8          ; top
        x19.aagu5 A9, A7, #5, #0
        x19.aagu5 A11, A10, #5, #0
        alu s4, s0, s0, #OP_ADD ; sum hi
        alu s5, s0, s0, #OP_ADD ; sum lo
        ldy s8, e12
        x19.xrd s3, #9          ; out[j - 1 - k], one ahead
        x02.ainc #9, #9
        ; sum += coefs[k] * (out[j - 1 - k] - top), each product exact as hi * 2^15 + lo:
        ; plo = (2cd)[15:0] = 2 lo, hi = round((c << 8) * d / 2^23) - lo[14]. order >= 1 here,
        ; so the count is tested at the bottom and the delay slots fetch the next term.
tap:    x19.xrd s1, #11         ; c
        x02.ainc #11, #11       ; (overwrites s2)
        alu s2, s3, s7, #OP_SUB ; d
        x02.x3 #0, #0, s0, s0, #5, #0, s0, #1, s12 ; s12 = plo
        x19.alu s13, s1, s11, #SHIFT ; c << 8
        x02.mpy s13, s13, s2    ; round((c << 8) * d / 2^23)
        alu s5, s5, s12, #OP_ADD ; 2 lo summed (< 31 * 2^16)
        alu s12, s12, s9, #OP_SUB
        x19.alu s12, s12, s10, #SHIFT ; lo[14] = floor(plo / 2^15)
        alu s13, s13, s12, #OP_SUB
        alu s4, s4, s13, #OP_ADD
        alu s8, s8, s14, #OP_SUB
        alu s6, s8, s14, #OP_SUB
        ptst p1, s6, #NEG, #PTST ; last term done
        jmp #IF_NOT, #1, tap
        x19.xrd s3, #9          ; (delay slot) next term
        x02.ainc #9, #9         ; (delay slot)
        alu s3, s0, s14, #OP_SUB
        x19.alu s5, s5, s3, #SHIFT ; lo (exact: even)
        ; normalise: lo < 31 * 2^15, carry it into hi
sum:    floorshr(s3, s5, 15)
        alu s4, s4, s3, #OP_ADD
        ldi s12, #15
        x19.alu s3, s3, s12, #SHIFT
        alu s5, s5, s3, #OP_SUB
        ; pred = hi << (15 - ds) (wrapping) + rshr(lo, ds)
        ldy s8, e13
        alu s3, s12, s8, #OP_SUB
        shlw(s4, s3)
        alu s3, s0, s8, #OP_SUB
        x19.alu s5, s5, s3, #SHIFT
        alu s4, s4, s5, #OP_ADD ; pred
        x19.xrd s1, #2          ; res
        x02.ainc #2, #2
        alu s3, s1, s7, #OP_ADD
        alu s3, s3, s4, #OP_ADD
        sxcb(s3)
        stx A3, s3              ; out[j]
        x02.ainc #3, #3
        ldy s5, e15
        alu s5, s5, s14, #OP_SUB
        x17.sty e15, #5, #0     ; left -= 1
        alu s5, s1, s14, #OP_SUB
        ptst p1, s5, #NEG, #PTST ; res <= 0
        jmp #IF_NOT, #1, adp    ; res > 0
        alu s5, s1, s0, #OP_ADD ; (delay slot) D = res
        nop()
        ptst p1, s1, #NEG, #PTST ; res < 0
        jmp #3, #1, adn
        alu s5, s0, s1, #OP_SUB ; (delay slot) D = -res
        nop()
        jmp #IF_NOT, #2, advance ; res == 0: no adaptation
        nop()
        nop()
        ; adaptation: i = 0 .. order - 1 (k = order - 1 - i), weight w = i + 1, one loop per
        ; sign of res. With D = +-del0 both stop at D <= 0:
        ;   res > 0: dd > 0: c -= 1, D -= w * floor(dd / 2^ds); dd < 0: c += 1, -dd instead
        ;   res < 0: dd > 0: c += 1, D += w * floor(-dd / 2^ds); dd < 0: c -= 1, dd instead
        ; Only the direction c moved can leave 16 bits, so each branch tests that one.
adp:    adapt_init()
pstep:  alu s3, s7, s3, #OP_SUB ; dd = top - out
        alu s12, s0, s3, #OP_SUB ; -dd
        ptst p1, s3, #NEG, #PTST
        jmp #3, #1, pneg
        x19.xrd s13, #11        ; (delay slot) c
        alu s2, s3, s9, #OP_SUB ; (delay slot) dd - h
        ptst p1, s12, #NEG, #PTST ; dd > 0
        jmp #IF_NOT, #1, pput   ; dd == 0: m = 0, c kept
        x19.alu s12, s2, s10, #SHIFT ; (delay slot) m = floor(dd / 2^ds)
        nop()
        alu s13, s13, s14, #OP_SUB ; c -= 1
        alu s3, s13, s6, #OP_ADD
        alu s3, s3, s14, #OP_ADD ; c + 2^15 < 0: c = 2^15 - 1
        ptst p1, s3, #NEG, #PTST
        jmp #IF_NOT, #1, pput
        nop()
        nop()
        alu s13, s6, s0, #OP_ADD
pput:   stx A11, s13
        x02.ainc #11, #11       ; (overwrites s2)
        x19.alu s12, s12, s11, #SHIFT ; m << 5
        x02.mpy s12, s4, s12    ; w * m, exact
        alu s5, s5, s12, #OP_SUB
        alu s4, s4, s1, #OP_ADD ; w += 1
        alu s8, s8, s14, #OP_SUB
        alu s3, s5, s14, #OP_SUB
        ptst p1, s3, #NEG, #PTST ; D <= 0: stop
        jmp #3, #1, adone
        x19.xrd s3, #9          ; (delay slot) next out
        x02.ainc #9, #9         ; (delay slot)
        alu s2, s8, s14, #OP_SUB
        ptst p1, s2, #NEG, #PTST ; every coefficient visited
        jmp #IF_NOT, #1, pstep
        nop()
        nop()
        jmp #IF_NOT, #2, adone
        nop()
        nop()
pneg:   alu s12, s12, s9, #OP_SUB
        x19.alu s12, s12, s10, #SHIFT ; m = floor(-dd / 2^ds)
        alu s13, s13, s14, #OP_ADD ; c += 1
        alu s3, s6, s13, #OP_SUB ; 2^15 - 1 - c < 0: c = -2^15
        ptst p1, s3, #NEG, #PTST
        jmp #IF_NOT, #1, pput
        nop()
        nop()
        alu s13, s0, s6, #OP_SUB
        alu s13, s13, s14, #OP_SUB
        jmp #IF_NOT, #2, pput
        nop()
        nop()
adn:    adapt_init()
nstep:  alu s3, s7, s3, #OP_SUB ; dd = top - out
        alu s12, s0, s3, #OP_SUB ; -dd
        ptst p1, s3, #NEG, #PTST
        jmp #3, #1, nneg
        x19.xrd s13, #11        ; (delay slot) c
        alu s2, s12, s9, #OP_SUB ; (delay slot) -dd - h
        ptst p1, s12, #NEG, #PTST ; dd > 0
        jmp #IF_NOT, #1, nput   ; dd == 0: m = 0, c kept
        x19.alu s12, s2, s10, #SHIFT ; (delay slot) m = floor(-dd / 2^ds)
        nop()
        alu s13, s13, s14, #OP_ADD ; c += 1
        alu s3, s6, s13, #OP_SUB ; 2^15 - 1 - c < 0: c = -2^15
        ptst p1, s3, #NEG, #PTST
        jmp #IF_NOT, #1, nput
        nop()
        nop()
        alu s13, s0, s6, #OP_SUB
        alu s13, s13, s14, #OP_SUB
nput:   stx A11, s13
        x02.ainc #11, #11       ; (overwrites s2)
        x19.alu s12, s12, s11, #SHIFT ; m << 5
        x02.mpy s12, s4, s12    ; w * m, exact
        alu s5, s5, s12, #OP_ADD
        alu s4, s4, s1, #OP_ADD ; w += 1
        alu s8, s8, s14, #OP_SUB
        alu s3, s5, s14, #OP_SUB
        ptst p1, s3, #NEG, #PTST ; D <= 0: stop
        jmp #3, #1, adone
        x19.xrd s3, #9          ; (delay slot) next out
        x02.ainc #9, #9         ; (delay slot)
        alu s2, s8, s14, #OP_SUB
        ptst p1, s2, #NEG, #PTST ; every coefficient visited
        jmp #IF_NOT, #1, nstep
        nop()
        nop()
        jmp #IF_NOT, #2, adone
        nop()
        nop()
nneg:   alu s12, s3, s9, #OP_SUB
        x19.alu s12, s12, s10, #SHIFT ; m = floor(dd / 2^ds)
        alu s13, s13, s14, #OP_SUB ; c -= 1
        alu s3, s13, s6, #OP_ADD
        alu s3, s3, s14, #OP_ADD ; c + 2^15 < 0: c = 2^15 - 1
        ptst p1, s3, #NEG, #PTST
        jmp #IF_NOT, #1, nput
        nop()
        nop()
        alu s13, s6, s0, #OP_ADD
        jmp #IF_NOT, #2, nput
        nop()
        nop()
adone:  ldi s9, #1 << 14        ; the tap constants back
        ldi s10, #-15
        ldi s11, #8
advance: x02.ainc #7, #7
        x02.ainc #8, #8
        jmp #IF_NOT, #2, sample
        nop()
        nop()
finish: x03.agu A5, A10, #32, #0, A0 ; the bit reader back
        x19.xrd s9, #5
        x02.ainc #5, #5
        x19.xrd s10, #5
}
