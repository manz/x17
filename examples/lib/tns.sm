; AAC temporal noise shaping: the x17 twin of sosumi's ref/dsp/aac/tns.zig.
;
; The all-pole filter runs as a lattice on the Q23 reflection coefficients, per sample:
;   f = x; for m = order .. 1: f -= k_m b_(m-1); b_m = k_m f + b_(m-1) (m < order); b_0 = f.
; k and b are stored reversed (K'[j] = k_(order-j), B'[j] = b_(order-1-j)), so a stage reads
; K'[j], B'[j] and writes B'[j-1]: three pointers that only step up. Every input, f and b stays
; inside (-2^22, 2^22); a value outside it puts the run back from a saved copy, halves the whole
; block (rounded, exponent + 1) and filters again, up to TN_MAXH times, then zeroes the run.
;
; Needs lib/bits.sm (s0 = 0, s14 = 1) and lib/mem.sm. Loaded by the host:
;   X TN_W the block's 1024 words (rewritten); X TN_K the reflection table, coef_res 0 at
;     TN_K + 4 + c (c = -4 .. 3), coef_res 1 at TN_K + 16 + c (c = -8 .. 7)
;   Y TN_E the exponent (rewritten), TN_NWIN windows, TN_WLEN window length, TN_NSWB bands,
;     TN_TOP min(TNS_MAX_BANDS, max_sfb), TN_MAXO TNS_MAX_ORDER, TN_OFF swb_offset;
;     TN_REC the parsed fields in stream order: per window n_filt, then if n_filt > 0 coef_res
;     and per filter length, order, then if order > 0 direction and the order codes
;   Out: Y TN_HALV halvings, TN_GIVE runs zeroed.
; Uses every s register but s0, s14, s15; e6, e7; R2, R3, R5, R7; A4, A6, A8, A10, A12, A14.

.const TN_W    = 0x0400
.const TN_SAVE = 0x0C00
.const TN_K    = 0x1F00
.const TN_KC   = 0x1F20         ; K', 12 words
.const TN_B    = 0x1F30         ; B', 12 words
.const TN_Y    = 0x2600
.const TN_E    = TN_Y + 0
.const TN_NWIN = TN_Y + 1
.const TN_WLEN = TN_Y + 2
.const TN_NSWB = TN_Y + 3
.const TN_TOP  = TN_Y + 4
.const TN_MAXO = TN_Y + 5
.const TN_HALV = TN_Y + 6
.const TN_GIVE = TN_Y + 7
.const TN_WI   = TN_Y + 8       ; windows left
.const TN_WB   = TN_Y + 9       ; window base
.const TN_TOPB = TN_Y + 10      ; the current filter's top band
.const TN_NF   = TN_Y + 11      ; filters left
.const TN_RES  = TN_Y + 12
.const TN_ST   = TN_Y + 13      ; run start
.const TN_LEN  = TN_Y + 14
.const TN_ORD  = TN_Y + 15
.const TN_DIR  = TN_Y + 16
.const TN_TRY  = TN_Y + 17
.const TN_OFF  = TN_Y + 0x20    ; 64 words
.const TN_REC  = TN_Y + 0x60
.const TN_MAXH = 48

; Y:[addr] = s<lo + 8 hi>.
.macro tn_yst(addr, lo, hi) {
        yat(addr)
        x17.sty e6, #lo, #hi
}

; A<2k> = s<src> + 2. Uses e6, R7.
.macro tn_aset(src, k) {
        x17.mve e6, src
        x19.a3 s0, R7, e6, #25, #2, #0
        x12.aset #k, R7
}

; Jumps to FAIL unless -L < s<V> < L, L = s7. Uses s4, p3.
.macro tn_small(V, FAIL) {
        alu s4, V, s7, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, FAIL   ; V >= L
        alu s4, V, s7, #OP_ADD  ; (delay slot)
        nop()
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, FAIL        ; V <= -L
        nop()
        nop()
}

; The lattice over s10 samples from A4, stepping R2; s11 = order >= 1, s7 = 2^22, B' zero.
; Jumps to FAIL when a value leaves the range. Uses s1, s4, s5, s6, s8, s9, s12, R3, A6, A8, A10.
.macro tn_lattice(FAIL) {
ls:     alu s4, s10, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, ldone
        ldi s12, #TN_KC - 2     ; (delay slot)
        nop()
        tn_aset(s12, 3)         ; A6 = K'
        ldi s12, #TN_B - 2
        tn_aset(s12, 4)         ; A8 = B' (read)
        tn_aset(s12, 5)         ; A10 = B' (write)
        x19.xrd s1, #4          ; f = x
        tn_small(s1, FAIL)
        x19.xrd s5, #6          ; stage m = order: no b written
        x02.ainc #6, #6
        x19.xrd s6, #8
        x02.ainc #8, #8
        x02.mpy s8, s5, s6
        alu s1, s1, s8, #OP_SUB
        tn_small(s1, FAIL)
        alu s9, s11, s14, #OP_SUB
st:     alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, sdone
        nop()
        nop()
        x19.xrd s5, #6          ; k_m
        x02.ainc #6, #6
        x19.xrd s6, #8          ; b_(m-1)
        x02.ainc #8, #8
        x02.mpy s8, s5, s6
        alu s1, s1, s8, #OP_SUB ; f_(m-1)
        tn_small(s1, FAIL)
        x02.mpy s8, s5, s1
        alu s8, s8, s6, #OP_ADD ; b_m
        tn_small(s8, FAIL)
        stx A10, s8
        x02.ainc #10, #10
        jmp #ALWAYS, #0, st
        alu s9, s9, s14, #OP_SUB ; (delay slot)
        nop()
sdone:  stx A10, s1             ; b_0 = y
        stx A4, s1
        x18.rag101 s0, R3, A4, R2, #2
        x12.aset #2, R3
        jmp #ALWAYS, #0, ls
        alu s10, s10, s14, #OP_SUB ; (delay slot)
        nop()
ldone:
}

; X[DST ..] = X[SRC ..] over s<N> words (s<N> kept). Uses s1, s4, s9, A4, A8 and aimm's.
.macro tn_copy(DST, SRC, N) {
        amov(A4, SRC)
        amov(A8, DST)
        alu s9, N, s0, #OP_ADD
cl:     alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, cdone
        nop()
        nop()
        x19.xrd s1, #4
        x02.ainc #4, #4
        stx A8, s1
        x02.ainc #8, #8
        jmp #ALWAYS, #0, cl
        alu s9, s9, s14, #OP_SUB ; (delay slot)
        nop()
cdone:
}

; X[A ..] halved, rounded, over s<N> words. Uses s1, s4, s9, s12, A4 and amov's.
.macro tn_halve(A, N) {
        amov(A4, A)
        alu s9, N, s0, #OP_ADD
        ldi s12, #-1
hl:     alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, hdone
        nop()
        nop()
        x19.xrd s1, #4
        x19.alu s1, s1, s12, #SHIFT
        stx A4, s1
        x02.ainc #4, #4
        jmp #ALWAYS, #0, hl
        alu s9, s9, s14, #OP_SUB ; (delay slot)
        nop()
hdone:
}

; One filter run: TN_ST, TN_LEN, TN_ORD (>= 1), TN_DIR in Y, K' loaded.
.macro tn_run() {
        ldi s1, #TN_W
        yld(s2, TN_ST)
        alu s1, s1, s2, #OP_ADD ; X address of the run
        ldi s3, #TN_SAVE
        yld(s10, TN_LEN)
        tn_copy(s3, s1, s10)
        ldi s3, #0
        yst(TN_TRY)
again:  aimm(A10, TN_B)         ; B' = 0
        ldi s9, #12
zb:     stx A10, s0
        x02.ainc #10, #10
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, zb
        nop()
        nop()
        ldi s1, #TN_W
        yld(s2, TN_ST)
        alu s1, s1, s2, #OP_ADD
        yld(s10, TN_LEN)
        rimm R2, #1
        yld(s4, TN_DIR)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, fwd
        nop()
        nop()
        rimm R2, #-1            ; backwards: from the last sample
        alu s1, s1, s10, #OP_ADD
        alu s1, s1, s14, #OP_SUB
fwd:    amov(A4, s1)
        yld(s11, TN_ORD)
        ldi s7, #22
        x19.alu s7, s14, s7, #SHIFT ; 2^22 (amov is done with s7)
        tn_lattice(fail)
        jmp #ALWAYS, #0, rdone
        nop()
        nop()
fail:   ldi s3, #TN_SAVE
        ldi s1, #TN_W
        yld(s2, TN_ST)
        alu s1, s1, s2, #OP_ADD
        yld(s10, TN_LEN)
        tn_copy(s1, s3, s10)    ; the run back
        yld(s3, TN_TRY)
        ldi s4, #TN_MAXH
        alu s4, s3, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, giveup
        alu s3, s3, s14, #OP_ADD ; (delay slot)
        nop()
        yst(TN_TRY)
        ldi s3, #TN_W
        ldi s10, #1024
        tn_halve(s3, s10)
        ldi s3, #TN_SAVE
        yld(s10, TN_LEN)
        tn_halve(s3, s10)
        yld(s3, TN_E)
        alu s3, s3, s14, #OP_ADD
        yst(TN_E)
        yld(s3, TN_HALV)
        alu s3, s3, s14, #OP_ADD
        yst(TN_HALV)
        jmp #ALWAYS, #0, again
        nop()
        nop()
giveup: ldi s1, #TN_W
        yld(s2, TN_ST)
        alu s1, s1, s2, #OP_ADD
        amov(A4, s1)
        yld(s9, TN_LEN)
gz:     stx A4, s0
        x02.ainc #4, #4
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, gz
        nop()
        nop()
        yld(s3, TN_GIVE)
        alu s3, s3, s14, #OP_ADD
        yst(TN_GIVE)
rdone:
}

; s<D> = Y:[TN_OFF + s<I>]. Uses s13, e6.
.macro tn_off(D, I) {
        ldi s13, #TN_OFF - 1
        alu s13, s13, I, #OP_ADD
        x17.mve e6, s13
        ldy D, e6
}

; One filter's fields from e7: TN_TOPB moves down, K' is loaded, and TN_ST / TN_LEN / TN_ORD /
; TN_DIR are set; TN_LEN = 0 when there is nothing to run.
.macro tn_filter() {
        ldy s1, e7              ; length
        x18.eagu e7, e7, #AGU_INC
        ldy s2, e7              ; order as sent
        x18.eagu e7, e7, #AGU_INC
        yld(s5, TN_TOPB)        ; top
        alu s6, s5, s1, #OP_SUB ; bottom = max(top - length, 0)
        alu s4, s6, s0, #OP_ADD
        ptst p3, s0, #LT4, #PTST
        alu s12, s0, s6, #OP_SUB
        psel s6, s12, s6, p3, #1, #4
        tn_yst(TN_TOPB, 6, 0)
        yld(s3, TN_MAXO)        ; ord = min(order, max_order)
        alu s4, s3, s2, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        alu s8, s2, s0, #OP_ADD
        psel s8, s4, s8, p3, #1, #4
        yld(s3, TN_TOP)         ; both ends clipped to TN_TOP
        alu s4, s3, s6, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        psel s6, s4, s6, p3, #1, #4
        alu s4, s3, s5, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        psel s5, s4, s5, p3, #1, #4
        tn_off(s10, s6)         ; start offset
        tn_off(s11, s5)         ; end offset
        yld(s3, TN_WB)
        alu s10, s10, s3, #OP_ADD
        tn_yst(TN_ST, 2, 1)     ; s10
        yld(s3, TN_WB)
        alu s11, s11, s3, #OP_ADD
        alu s11, s11, s10, #OP_SUB ; len = end - start
        alu s3, s8, s0, #OP_ADD
        yst(TN_ORD)
        ; codes: the first ord into K' reversed, the rest skipped
        ldi s3, #0
        yst(TN_DIR)
        alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, nocodes
        nop()
        nop()
        ldy s3, e7              ; direction
        x18.eagu e7, e7, #AGU_INC
        yst(TN_DIR)
        tn_yst(TN_LEN, 3, 1)    ; s11 (amov below uses s7, s12, s13)
        ldi s1, #TN_KC - 1
        alu s1, s1, s8, #OP_ADD ; K'[ord - 1]
        amov(A12, s1)
        rimm R5, #-1
        yld(s3, TN_RES)
        ldi s5, #TN_K + 4
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, cl
        nop()
        nop()
        ldi s5, #TN_K + 16
cl:     alu s4, s2, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, cdone
        nop()
        nop()
        ldy s6, e7              ; code
        x18.eagu e7, e7, #AGU_INC
        alu s2, s2, s14, #OP_SUB
        alu s4, s8, s0, #OP_ADD
        ptst p3, s0, #LE4, #PTST ; the delay slot counts skipped codes too
        jmp #3, #3, cl          ; past ord: skipped
        alu s8, s8, s14, #OP_SUB ; (delay slot)
        nop()
        alu s6, s5, s6, #OP_ADD
        amov(A8, s6)
        x19.xrd s6, #8
        stx A12, s6
        x18.rag101 s0, R3, A12, R5, #2
        x12.aset #6, R3
        jmp #ALWAYS, #0, cl
        nop()
        nop()
cdone:  yld(s11, TN_LEN)
nocodes: tn_yst(TN_LEN, 3, 1)   ; s11
        ; nothing to run when ord = 0 or len <= 0
        yld(s4, TN_ORD)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, fdone
        nop()
        nop()
        ldi s3, #0
        yst(TN_LEN)
fdone:
}

; tns_channel(): every window's filters, top down, in place.
.macro tns_channel() {
        ldi s13, #TN_REC - 1
        x17.mve e7, s13
        ldi s3, #0
        yst(TN_WB)
        yst(TN_HALV)
        yst(TN_GIVE)
        yld(s3, TN_NWIN)
        yst(TN_WI)
win:    yld(s4, TN_WI)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, done
        nop()
        nop()
        yld(s3, TN_NSWB)
        yst(TN_TOPB)
        ldy s3, e7              ; n_filt
        x18.eagu e7, e7, #AGU_INC
        yst(TN_NF)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wnext
        nop()
        nop()
        ldy s3, e7              ; coef_res
        x18.eagu e7, e7, #AGU_INC
        yst(TN_RES)
filt:   yld(s4, TN_NF)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wnext
        alu s3, s4, s14, #OP_SUB ; (delay slot)
        nop()
        yst(TN_NF)
        tn_filter()
        yld(s4, TN_LEN)
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, filt
        nop()
        nop()
        tn_run()
        jmp #ALWAYS, #0, filt
        nop()
        nop()
wnext:  yld(s3, TN_WI)
        alu s3, s3, s14, #OP_SUB
        yst(TN_WI)
        yld(s3, TN_WB)
        yld(s4, TN_WLEN)
        alu s3, s3, s4, #OP_ADD
        yst(TN_WB)
        jmp #ALWAYS, #0, win
        nop()
        nop()
done:
}
