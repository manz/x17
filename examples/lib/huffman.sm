; Table-driven Huffman decoding: the x17 twin of sosumi's ref/dsp/aac/huffman.zig `decode`.
;
; A code is a tree of lookup tables in Y, one 16-bit word per entry. A step peeks w <= 8 bits
; and reads the entry at base + those bits. Its low five bits f say what it is:
;   1..8      a leaf: the codeword is f bits long; value = entry >> 5
;   16 + w'   a pointer: consume w bits; the next table is at start + (entry >> 5), w' wide
; (0 marks a prefix no codeword has; complete codes have none, and this routine does not test
; for it.)
;
; huff_decode(dst): s1 = the code's Y address, s11 = its root width (1..8). dst = the value.
; Uses the bit reader's registers (lib/bits.sm) and s2, s3, s4, s5, s7, s8; s1 and s11 are
; clobbered. hi = floor(e / 32) = rshr(e - 16, 5) (exact for e >= 0). ldy sign-extends
; (fact 409), so every entry must stay below 0x8000: values and bases below 1024.

.macro huff_decode(dst) {
        alu s1, s1, s14, #OP_SUB ; s1, s3 sit one below the table: x17.mve adds 1
        ldi s4, #-5
        alu s3, s1, s0, #OP_ADD ; start of the code - 1
        ldi s8, #5
step:   alu s12, s10, s11, #OP_SUB ; avail - w
        ptst p3, s0, #LT12, #PTST ; p3 = avail < w
        jmp #IF_NOT, #3, have
        ldy s13, e5             ; delay slot: next word, harmless if unused
        alu s6, s0, s14, #OP_SUB ; delay slot: s6 = -1
        refill()
have:   alu s7, s10, s11, #OP_SUB ; sh = avail - w
        x19.alu s13, s14, s7, #SHIFT ; 2^sh
        alu s13, s13, s14, #OP_SUB ; 2^sh - 1
        x19.alu s13, s13, s6, #SHIFT ; h = rshr(2^sh - 1, 1)
        alu s13, s9, s13, #OP_SUB ; c - h
        alu s12, s0, s7, #OP_SUB ; -sh
        x19.alu s5, s13, s12, #SHIFT ; t = floor(c / 2^sh), the peeked w bits
        alu s13, s1, s5, #OP_ADD ; entry address - 1
        x17.mve e6, s13         ; e6 = entry address
        ldy s2, e6              ; e
        alu s13, s2, s15, #OP_SUB ; e - 16
        x19.alu s13, s13, s4, #SHIFT ; hi = rshr(e - 16, 5)
        x19.alu s12, s13, s8, #SHIFT ; hi << 5
        alu s2, s2, s12, #OP_SUB ; f
        alu s12, s2, s15, #OP_SUB ; f - 16
        ptst p3, s0, #LT12, #PTST ; p3 = leaf
        jmp #3, #3, leaf
        alu s1, s3, s13, #OP_ADD ; (delay slot) pointer: next table
        alu s11, s12, s0, #OP_ADD ; (delay slot) pointer: its width
        x19.alu s12, s5, s7, #SHIFT ; pointer: consume w bits, t << sh
        alu s9, s9, s12, #OP_SUB ;          cache keeps the low sh bits
        alu s10, s7, s0, #OP_ADD ;          avail = sh
        jmp #ALWAYS, #0, step
        nop()
        nop()
leaf:   alu s11, s2, s0, #OP_ADD ; consume f bits
        alu s2, s13, s0, #OP_ADD ; keep the value past getbits_s
        getbits_s(s13)
        alu dst, s2, s0, #OP_ADD
}

; Spectral codewords (sosumi ref/dsp/aac/huffman.zig `decodeSpectral`): one macro per book
; family, since the field width, offset, sign bits and escapes are fixed per book. Each takes
; s1 = the book's Y address and s11 = its root width, decodes one codeword and stores its values
; in order to X:[A6], A6 advancing. The leaf holds the values plus offset, the last lowest:
; 2-bit fields for 4-tuples, 5-bit for pairs. floor(v / 2^f) = rshr(v - 2^(f-1), f), v >= 0.

; field(hi, lo, v, f, m): hi = floor(v / 2^f), lo = v - hi * 2^f; m = 2^(f-1). Uses s4, s13.
.macro field(hi, lo, v, f, m) {
        ldi s4, #m
        alu s13, v, s4, #OP_SUB
        ldi s4, #-f
        x19.alu hi, s13, s4, #SHIFT
        ldi s4, #f
        x19.alu s13, hi, s4, #SHIFT
        alu lo, v, s13, #OP_SUB
}

; spec_put(x): X:[A6] <- x, A6 + 1.
.macro spec_put(x) {
        stx A6, x
        x02.ainc #6, #6
}

; spec_sign(x): a non-zero x reads one sign bit; 1 negates it. Uses s4, s8.
.macro spec_sign(x) {
        alu s4, x, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST ; zero: no sign bit
        jmp #3, #3, done
        nop()
        nop()
        getbits(s8, 1)
        ptst p3, s0, #EQ8, #PTST
        jmp #3, #3, done
        nop()
        nop()
        alu x, s0, x, #OP_SUB
done:
}

; spec_esc(x, fail): |x| = 16 reads escape_prefix (N ones, a zero; N > 8 jumps to fail) and an
; (N + 4)-bit word; x = sign(x) (2^(N+4) + word). Uses s4, s5, s7, s8 and readn's registers.
.macro spec_esc(x, fail) {
        alu s4, x, s0, #OP_ADD
        ptst p3, s0, #LT4, #PTST
        alu s5, x, s0, #OP_ADD  ; |x|
        jmp #IF_NOT, #3, pos
        nop()
        nop()
        alu s5, s0, x, #OP_SUB
pos:    alu s4, s5, s15, #OP_SUB ; |x| - 16
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, done
        ldi s7, #0              ; (delay slot) N = 0
        nop()
pre:    getbits(s8, 1)
        ptst p3, s0, #EQ8, #PTST ; the prefix's zero
        jmp #3, #3, word
        nop()
        nop()
        alu s7, s7, s14, #OP_ADD ; N + 1
        ldi s4, #9
        alu s12, s7, s4, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; N = 9
        jmp #3, #3, fail
        nop()
        nop()
        jmp #ALWAYS, #0, pre
        nop()
        nop()
word:   ldi s4, #4
        alu s7, s7, s4, #OP_ADD ; N + 4
        alu s4, s7, s0, #OP_ADD ; kept past readn
        readn(s8)
        x19.alu s5, s14, s4, #SHIFT ; 2^(N+4)
        alu s5, s5, s8, #OP_ADD ; + word
        alu s4, x, s0, #OP_ADD
        ptst p3, s0, #LT4, #PTST
        alu x, s5, s0, #OP_ADD
        jmp #IF_NOT, #3, done
        nop()
        nop()
        alu x, s0, x, #OP_SUB
done:
}

; Books 5, 6: two signed values, offset 4.
.macro spec_pair_s() {
        huff_decode(s1)
        field(s2, s3, s1, 5, 16)
        ldi s4, #4
        alu s2, s2, s4, #OP_SUB
        alu s3, s3, s4, #OP_SUB
        spec_put(s2)
        spec_put(s3)
}

; Books 7..10: two magnitudes, then a sign bit for each non-zero one.
.macro spec_pair_u() {
        huff_decode(s1)
        field(s2, s3, s1, 5, 16)
        spec_sign(s2)
        spec_sign(s3)
        spec_put(s2)
        spec_put(s3)
}

; Book 11: as 7..10, then escapes for 16s.
.macro spec_pair_esc(fail) {
        huff_decode(s1)
        field(s2, s3, s1, 5, 16)
        spec_sign(s2)
        spec_sign(s3)
        spec_esc(s2, fail)
        spec_esc(s3, fail)
        spec_put(s2)
        spec_put(s3)
}

; quad: s2, s3, s5, s7 <- the four 2-bit fields of s1, first value first. Uses s8.
.macro quad() {
        huff_decode(s1)
        field(s8, s7, s1, 2, 2)
        field(s1, s5, s8, 2, 2)
        field(s2, s3, s1, 2, 2)
}

; Books 1, 2: four signed values, offset 1.
.macro spec_quad_s() {
        quad()
        alu s2, s2, s14, #OP_SUB
        alu s3, s3, s14, #OP_SUB
        alu s5, s5, s14, #OP_SUB
        alu s7, s7, s14, #OP_SUB
        spec_put(s2)
        spec_put(s3)
        spec_put(s5)
        spec_put(s7)
}

; Books 3, 4: four magnitudes, then sign bits.
.macro spec_quad_u() {
        quad()
        spec_sign(s2)
        spec_sign(s3)
        spec_sign(s5)
        spec_sign(s7)
        spec_put(s2)
        spec_put(s3)
        spec_put(s5)
        spec_put(s7)
}
